/* TeleClean — Telegram Light Theme (tgui tokens)
 *
 * Based on @xelene/tgui design tokens:
 *   bg_color:              #FFFFFF
 *   secondary_bg_color:    #EFEFF4
 *   card_bg_color:         #FFFFFF
 *   tertiary_bg_color:     #F4F4F7
 *   text_color:            #000000
 *   hint_color:            #707579
 *   secondary_hint_color:  #A2ACB0
 *   button_color:          #007AFF
 *   destructive:           #E53935
 *   green:                 #31D158
 *   divider:               rgba(0,0,0,.15)
 *   outline:               rgba(0,0,0,.05)
 */

/* Global ------------------------------------------------------------ */
QWidget {
    background-color: #FFFFFF;
    color: #000000;
    font-family: system-ui, -apple-system, "Segoe UI", "Roboto", "Helvetica Neue", Arial, sans-serif;
    font-size: 17px;
}

QMainWindow {
    background-color: #FFFFFF;
}

/* Labels ------------------------------------------------------------ */
QLabel {
    background-color: transparent;
    border: none;
    color: #000000;
}

QLabel#titleLabel {
    font-size: 19px;
    font-weight: 700;
    color: #000000;
}

QLabel#subtitleLabel {
    font-size: 15px;
    color: #707579;
}

QLabel#statusLabel {
    font-size: 13px;
    color: #707579;
}

QLabel#errorLabel {
    font-size: 13px;
    color: #E53935;
}

/* Line edits -------------------------------------------------------- */
QLineEdit {
    background-color: #F4F4F7;
    border: 1px solid rgba(0, 0, 0, .05);
    border-radius: 10px;
    padding: 10px 14px;
    color: #000000;
    font-size: 15px;
    selection-background-color: #007AFF;
}

QLineEdit:focus {
    border: 2px solid #007AFF;
    padding: 9px 13px;
}

QLineEdit:disabled {
    background-color: #EFEFF4;
    color: #A2ACB0;
}

QLineEdit::placeholder {
    color: #A2ACB0;
}

/* Push buttons ------------------------------------------------------ */
QPushButton {
    background-color: #007AFF;
    border: none;
    border-radius: 10px;
    padding: 10px 24px;
    color: #FFFFFF;
    font-size: 17px;
    font-weight: 600;
    min-height: 24px;
}

QPushButton:hover {
    background-color: #3395FF;
}

QPushButton:pressed {
    background-color: #0066CC;
}

QPushButton:disabled {
    background-color: #E0E0E0;
    color: #A2ACB0;
}

QPushButton#dangerButton {
    background-color: #E53935;
}

QPushButton#dangerButton:hover {
    background-color: #FF5252;
}

QPushButton#dangerButton:pressed {
    background-color: #C62828;
}

QPushButton#dangerButton:disabled {
    background-color: #F5E0E0;
    color: #CC9999;
}

QPushButton#secondaryButton {
    background-color: #F4F4F7;
    border: 1px solid rgba(0, 0, 0, .05);
    color: #000000;
}

QPushButton#secondaryButton:hover {
    background-color: #E8E8ED;
}

QPushButton#secondaryButton:pressed {
    background-color: #DCDCE1;
}

QPushButton#linkButton {
    background-color: transparent;
    color: #007AFF;
    font-weight: normal;
    text-decoration: underline;
    padding: 4px 8px;
}

QPushButton#linkButton:hover {
    color: #3395FF;
}

/* Checkboxes -------------------------------------------------------- */
QCheckBox {
    spacing: 10px;
    padding: 2px 4px;
    color: #000000;
    font-size: 15px;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border: 2px solid #A2ACB0;
    border-radius: 4px;
    background-color: transparent;
}

QCheckBox::indicator:hover {
    border-color: #007AFF;
    background-color: rgba(0, 122, 255, 0.08);
}

QCheckBox::indicator:checked {
    background-color: #007AFF;
    border-color: #007AFF;
}

QCheckBox::indicator:disabled {
    border-color: #D0D0D0;
}

/* List widget ------------------------------------------------------- */
QListWidget {
    background-color: #FFFFFF;
    border: none;
    outline: none;
    padding: 0px 0px 32px 0px;
}

QListWidget::item {
    background-color: #FFFFFF;
    border: none;
    border-radius: 0px;
    margin: 0px;
    padding: 0px;
    color: #000000;
}

QListWidget::item:hover {
    background-color: #F4F4F7;
}

QListWidget::item:selected {
    background-color: #F4F4F7;
}

/* Scroll bars ------------------------------------------------------- */
QScrollBar:vertical {
    background-color: #FFFFFF;
    width: 6px;
    border: none;
}

QScrollBar::handle:vertical {
    background-color: #C0C0C0;
    border-radius: 3px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background-color: #A0A0A0;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background-color: #FFFFFF;
    height: 6px;
    border: none;
}

QScrollBar::handle:horizontal {
    background-color: #C0C0C0;
    border-radius: 3px;
    min-width: 30px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #A0A0A0;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

/* Progress bar ------------------------------------------------------ */
QProgressBar {
    background-color: #F4F4F7;
    border: none;
    border-radius: 6px;
    text-align: center;
    color: #000000;
    font-size: 13px;
    min-height: 20px;
}

QProgressBar::chunk {
    background-color: #007AFF;
    border-radius: 6px;
}

/* Menu bar ---------------------------------------------------------- */
QMenuBar {
    background-color: #EFEFF4;
    border-bottom: 1px solid rgba(0, 0, 0, .15);
    padding: 2px;
    color: #000000;
}

QMenuBar::item {
    padding: 6px 12px;
    border-radius: 4px;
}

QMenuBar::item:selected {
    background-color: #DCDCE1;
}

QMenu {
    background-color: #FFFFFF;
    border: 1px solid rgba(0, 0, 0, .05);
    border-radius: 10px;
    padding: 4px;
}

QMenu::item {
    padding: 8px 32px 8px 16px;
    border-radius: 4px;
    color: #000000;
}

QMenu::item:selected {
    background-color: #007AFF;
    color: #FFFFFF;
}

/* Message boxes ----------------------------------------------------- */
QMessageBox {
    background-color: #FFFFFF;
}

QMessageBox QLabel {
    color: #000000;
}

QMessageBox QPushButton {
    min-width: 80px;
}

/* Combo box --------------------------------------------------------- */
QComboBox {
    background-color: #F4F4F7;
    border: 1px solid rgba(0, 0, 0, .05);
    border-radius: 10px;
    padding: 8px 14px;
    color: #000000;
    font-size: 15px;
}

QComboBox:focus {
    border: 2px solid #007AFF;
    padding: 7px 13px;
}

QComboBox::drop-down {
    border: none;
    width: 30px;
}

QComboBox::down-arrow {
    image: none;
    border-left: 5px solid transparent;
    border-right: 5px solid transparent;
    border-top: 6px solid #707579;
    margin-right: 8px;
}

QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    border: 1px solid rgba(0, 0, 0, .05);
    border-radius: 10px;
    selection-background-color: #007AFF;
    color: #000000;
}

/* Tool tips --------------------------------------------------------- */
QToolTip {
    background-color: #FFFFFF;
    border: 1px solid rgba(0, 0, 0, .05);
    border-radius: 6px;
    padding: 6px 10px;
    color: #000000;
    font-size: 13px;
}

/* Group box --------------------------------------------------------- */
QGroupBox {
    border: 1px solid rgba(0, 0, 0, .15);
    border-radius: 10px;
    margin-top: 16px;
    padding: 16px 12px 12px;
    font-size: 15px;
    color: #707579;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 6px;
    color: #707579;
}
