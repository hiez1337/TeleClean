<UserControl x:Class="TeleClean.App.Views.AuthView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:TeleClean.App.Controls">
    <Grid Background="Transparent">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollMode="Disabled"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalContentAlignment="Stretch"
                      HorizontalContentAlignment="Stretch">
            <Grid Padding="24,20" VerticalAlignment="Center">
                <StackPanel MaxWidth="680" HorizontalAlignment="Stretch" Spacing="18">
                    <!-- Hero Brand Header -->
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="42" Height="42" Background="{ThemeResource BrandPrimaryBrush}" CornerRadius="11" VerticalAlignment="Top" Margin="0,2,0,0">
                            <FontIcon Glyph="&#xE724;" FontSize="19" Foreground="{ThemeResource OnBrandBrush}"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                            <TextBlock Text="Подключите Telegram" Style="{StaticResource PageTitleStyle}" AutomationProperties.HeadingLevel="Level1"/>
                            <TextBlock Text="Сначала просмотрите диалоги. TeleClean покажет состав и последствия операции перед запуском."
                                       Style="{StaticResource SupportingTextStyle}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Main Auth Card -->
                    <Border Style="{StaticResource CardPanelStyle}" Padding="26,24">
                        <StackPanel Spacing="16">
                            <InfoBar Title="Вход не завершён"
                                     IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                                     Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                                     Severity="Error"
                                     IsClosable="False"/>

                            <ProgressBar Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}" IsIndeterminate="True"/>

                            <!-- Session Recovery Mode -->
                            <StackPanel Visibility="{x:Bind ViewModel.IsRecoveryMode, Mode=OneWay}" Spacing="14">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Восстановление сессии" Style="{StaticResource SectionTitleStyle}" AutomationProperties.HeadingLevel="Level2"/>
                                    <TextBlock Text="Используется сохранённая локальная сессия для повторного входа." Style="{StaticResource SupportingTextStyle}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Command="{x:Bind ViewModel.InitializeCommand}"
                                            IsEnabled="{x:Bind ViewModel.IsReady, Mode=OneWay}"
                                            Style="{ThemeResource AccentButtonStyle}">
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <FontIcon Glyph="&#xE72C;" FontSize="13"/>
                                            <TextBlock Text="Повторить подключение"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Content="Войти по QR-коду"
                                            Command="{x:Bind ViewModel.SwitchToQrModeCommand}"
                                            IsEnabled="{x:Bind ViewModel.IsReady, Mode=OneWay}"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- QR Login Mode -->
                            <Grid x:Name="QrLayout"
                                  Visibility="{x:Bind ViewModel.IsQrMode, Mode=OneWay}"
                                  ColumnSpacing="26"
                                  RowSpacing="18"
                                  SizeChanged="OnQrLayoutSizeChanged">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Border x:Name="QrTile"
                                        Background="White"
                                        BorderBrush="{ThemeResource QrFrameBorderBrush}"
                                        BorderThickness="1"
                                        Width="252" Height="252"
                                        CornerRadius="12"
                                        Padding="8"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center">
                                    <Grid>
                                        <Image Source="{x:Bind ViewModel.QrCodeImage, Mode=OneWay}"
                                               AutomationProperties.Name="QR-код для входа в Telegram"/>
                                        <ProgressRing Width="30" Height="30"
                                                      IsActive="{x:Bind ViewModel.IsQrLoading, Mode=OneWay}"
                                                      RequestedTheme="Light"/>
                                    </Grid>
                                </Border>

                                <StackPanel x:Name="QrInstructions" Grid.Column="1" VerticalAlignment="Center" Spacing="14">
                                    <TextBlock Text="Вход по QR-коду" Style="{StaticResource SectionTitleStyle}" AutomationProperties.HeadingLevel="Level2"/>

                                    <!-- Numbered Step Guide -->
                                    <StackPanel Spacing="9">
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Border Width="22" Height="22" CornerRadius="11" Background="{ThemeResource StatusAccentBgBrush}" VerticalAlignment="Top" Margin="0,1,0,0">
                                                <TextBlock Text="1" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource StatusAccentFgBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="Откройте Telegram на телефоне." Style="{StaticResource SupportingTextStyle}" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Border Width="22" Height="22" CornerRadius="11" Background="{ThemeResource StatusAccentBgBrush}" VerticalAlignment="Top" Margin="0,1,0,0">
                                                <TextBlock Text="2" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource StatusAccentFgBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="Перейдите в «Настройки» → «Устройства»." Style="{StaticResource SupportingTextStyle}" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Border Width="22" Height="22" CornerRadius="11" Background="{ThemeResource StatusAccentBgBrush}" VerticalAlignment="Top" Margin="0,1,0,0">
                                                <TextBlock Text="3" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource StatusAccentFgBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="Нажмите «Подключить устройство» и наведите камеру на код." Style="{StaticResource SupportingTextStyle}" VerticalAlignment="Center"/>
                                        </Grid>
                                    </StackPanel>

                                    <controls:StatusBadge HorizontalAlignment="Left"
                                                          Text="{x:Bind ViewModel.QrStatusText, Mode=OneWay}"
                                                          Tone="{x:Bind ViewModel.QrStatusTone, Mode=OneWay}"
                                                          ShowDot="True"
                                                          AutomationProperties.LiveSetting="Polite"/>

                                    <StackPanel Spacing="8" Margin="0,2,0,0">
                                        <Button HorizontalAlignment="Stretch"
                                                Command="{x:Bind ViewModel.StartQrLoginCommand}"
                                                IsEnabled="{x:Bind ViewModel.IsReady, Mode=OneWay}">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon Glyph="&#xE72C;" FontSize="13"/>
                                                <TextBlock Text="Обновить QR-код"/>
                                            </StackPanel>
                                        </Button>
                                        <Button HorizontalAlignment="Stretch"
                                                Command="{x:Bind ViewModel.SwitchToPhoneModeCommand}"
                                                IsEnabled="{x:Bind ViewModel.IsReady, Mode=OneWay}">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon Glyph="&#xE717;" FontSize="13"/>
                                                <TextBlock Text="Войти по номеру телефона"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>

                            <!-- Phone Login Mode -->
                            <StackPanel Visibility="{x:Bind ViewModel.IsPhoneMode, Mode=OneWay}" MaxWidth="420" HorizontalAlignment="Left" Spacing="12">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Вход по телефону" Style="{StaticResource SectionTitleStyle}" AutomationProperties.HeadingLevel="Level2"/>
                                    <TextBlock Text="Укажите номер в международном формате, чтобы получить код подтверждения в Telegram." Style="{StaticResource SupportingTextStyle}"/>
                                </StackPanel>
                                <TextBox x:Name="PhoneInput"
                                         Header="Номер с кодом страны"
                                         PlaceholderText="+7 900 123-45-67"
                                         InputScope="TelephoneNumber"
                                         KeyDown="OnPhoneInputKeyDown"
                                         Text="{x:Bind ViewModel.PhoneNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{x:Bind ViewModel.IsPhoneInputEnabled, Mode=OneWay}"/>
                                <Button Content="Получить код"
                                        Command="{x:Bind ViewModel.SendPhoneCodeCommand}"
                                        Style="{ThemeResource AccentButtonStyle}"
                                        Visibility="{x:Bind ViewModel.IsSendCodeButtonVisible, Mode=OneWay}"/>
                                <StackPanel Visibility="{x:Bind ViewModel.IsCodeInputVisible, Mode=OneWay}" Spacing="10">
                                    <TextBox x:Name="CodeInput"
                                             Header="Код подтверждения"
                                             PlaceholderText="Введите код из Telegram"
                                             InputScope="Number"
                                             KeyDown="OnCodeInputKeyDown"
                                             Text="{x:Bind ViewModel.PhoneCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Content="Подтвердить код"
                                                Command="{x:Bind ViewModel.SubmitPhoneCodeCommand}"
                                                Style="{ThemeResource AccentButtonStyle}"/>
                                        <Button Content="Изменить номер"
                                                Command="{x:Bind ViewModel.SwitchToPhoneModeCommand}"/>
                                    </StackPanel>
                                </StackPanel>
                                <Button Command="{x:Bind ViewModel.SwitchToQrModeCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <FontIcon Glyph="&#xED14;" FontSize="13"/>
                                        <TextBlock Text="Вернуться к QR-коду"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <!-- 2FA Password Mode -->
                            <StackPanel Visibility="{x:Bind ViewModel.Is2FaMode, Mode=OneWay}" MaxWidth="420" HorizontalAlignment="Left" Spacing="12">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Облачный пароль Telegram" Style="{StaticResource SectionTitleStyle}" AutomationProperties.HeadingLevel="Level2"/>
                                    <TextBlock Text="Для этого аккаунта включена двухэтапная аутентификация." Style="{StaticResource SupportingTextStyle}"/>
                                </StackPanel>
                                <PasswordBox x:Name="PasswordInput"
                                             KeyDown="OnPasswordInputKeyDown"
                                             Password="{x:Bind ViewModel.TwoFactorPassword, Mode=TwoWay}">
                                    <PasswordBox.Header>
                                        <TextBlock Text="Пароль двухэтапной аутентификации" TextWrapping="Wrap"/>
                                    </PasswordBox.Header>
                                </PasswordBox>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="Войти"
                                            Command="{x:Bind ViewModel.Submit2FaCommand}"
                                            Style="{ThemeResource AccentButtonStyle}"/>
                                    <Button Content="Вернуться к QR-коду"
                                            Command="{x:Bind ViewModel.SwitchToQrModeCommand}"/>
                                </StackPanel>
                            </StackPanel>

                            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                                       Style="{StaticResource SupportingTextStyle}"
                                       Visibility="{x:Bind ViewModel.HasStatusMessage, Mode=OneWay}"
                                       AutomationProperties.LiveSetting="Polite"/>

                            <!-- Unified Connection Footer -->
                            <Border BorderThickness="0,1,0,0" BorderBrush="{ThemeResource SubtleDividerBrush}" Padding="0,14,0,0" Margin="0,4,0,0">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Click="OnProxySettingsClick"
                                            IsEnabled="{x:Bind ViewModel.IsReady, Mode=OneWay}"
                                            Style="{StaticResource SubtleIconButtonStyle}"
                                            HorizontalAlignment="Left"
                                            Padding="8,6">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE774;" FontSize="14" Foreground="{ThemeResource BrandTextBrush}"/>
                                            <TextBlock Text="Настройки подключения (MTProxy)" FontSize="13"/>
                                        </StackPanel>
                                    </Button>
                                    <controls:StatusBadge Grid.Column="1"
                                                          Text="MTProxy активен"
                                                          Tone="Accent"
                                                          ShowDot="True"
                                                          Visibility="{x:Bind ViewModel.HasProxyConfigured, Mode=OneWay}"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
