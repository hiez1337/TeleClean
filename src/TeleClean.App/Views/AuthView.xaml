<UserControl x:Class="TeleClean.App.Views.AuthView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{ThemeResource WorkspaceBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="744" Margin="24,24" Spacing="16">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Border Width="36" Height="36" Background="{ThemeResource BrandBrush}" CornerRadius="10">
                        <FontIcon Glyph="&#xE724;" FontSize="17" Foreground="{ThemeResource OnBrandBrush}"/>
                    </Border>
                    <TextBlock Text="TeleClean" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="16"/>
                </StackPanel>
                <StackPanel Spacing="5">
                    <TextBlock Text="Подключите Telegram" Style="{StaticResource WorkspaceTitle}" TextWrapping="Wrap" AutomationProperties.HeadingLevel="Level1"/>
                    <TextBlock Text="Сначала просмотрите диалоги. TeleClean покажет состав и последствия операции перед запуском." Style="{StaticResource SupportingText}"/>
                </StackPanel>
                <Border Style="{StaticResource WorkspacePanel}" Padding="20">
                    <StackPanel Spacing="12">
                        <InfoBar Title="Вход не завершён" IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                                 Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" Severity="Error" IsClosable="False"/>
                        <ProgressBar Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}" IsIndeterminate="True"/>
                        <StackPanel Visibility="{x:Bind ViewModel.IsRecoveryMode, Mode=OneWay}" Spacing="12">
                            <TextBlock Text="Подключение к Telegram" Style="{ThemeResource SubtitleTextBlockStyle}"/>
                            <TextBlock Text="Сохранённая сессия используется для повторного входа." Style="{StaticResource SupportingText}"/>
                            <Button Content="Повторить подключение" Command="{x:Bind ViewModel.InitializeCommand}"
                                    IsEnabled="{x:Bind ViewModel.IsReady, Mode=OneWay}" Style="{ThemeResource AccentButtonStyle}"/>
                            <HyperlinkButton Content="Настройки подключения" Click="OnProxySettingsClick"
                                             IsEnabled="{x:Bind ViewModel.IsReady, Mode=OneWay}"/>
                            <Button Content="Открыть вход по QR-коду" Command="{x:Bind ViewModel.SwitchToQrModeCommand}"
                                    IsEnabled="{x:Bind ViewModel.IsReady, Mode=OneWay}"/>
                        </StackPanel>
                        <Grid x:Name="QrLayout" Visibility="{x:Bind ViewModel.IsQrMode, Mode=OneWay}"
                              ColumnSpacing="24" RowSpacing="16" SizeChanged="OnQrLayoutSizeChanged">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Border Background="White" Width="260" Height="260" CornerRadius="10" HorizontalAlignment="Left">
                                <Grid>
                                    <Image Source="{x:Bind ViewModel.QrCodeImage, Mode=OneWay}" AutomationProperties.Name="QR-код для входа в Telegram"/>
                                    <ProgressRing Width="28" Height="28" IsActive="{x:Bind ViewModel.IsQrLoading, Mode=OneWay}" RequestedTheme="Light"/>
                                </Grid>
                            </Border>
                            <StackPanel x:Name="QrInstructions" Grid.Column="1" VerticalAlignment="Center" Spacing="12">
                                <TextBlock Text="Вход по QR-коду" Style="{ThemeResource SubtitleTextBlockStyle}" AutomationProperties.HeadingLevel="Level2"/>
                                <TextBlock Text="На телефоне откройте Telegram → Настройки → Устройства → Подключить устройство. Наведите камеру на код." Style="{StaticResource SupportingText}"/>
                                <TextBlock Text="{x:Bind ViewModel.QrStatusText, Mode=OneWay}" Style="{StaticResource SupportingText}" AutomationProperties.LiveSetting="Polite"/>
                                <Button Content="Обновить QR-код" Command="{x:Bind ViewModel.StartQrLoginCommand}"/>
                                <Button Content="Войти по номеру телефона" Command="{x:Bind ViewModel.SwitchToPhoneModeCommand}"/>
                                <HyperlinkButton Content="Настройки подключения" Click="OnProxySettingsClick" IsEnabled="{x:Bind ViewModel.IsReady, Mode=OneWay}"/>
                            </StackPanel>
                        </Grid>
                        <StackPanel Visibility="{x:Bind ViewModel.IsPhoneMode, Mode=OneWay}" Spacing="12">
                            <TextBlock Text="Вход по телефону" Style="{ThemeResource SubtitleTextBlockStyle}"/>
                            <TextBox x:Name="PhoneInput" Header="Номер с кодом страны" InputScope="TelephoneNumber"
                                Text="{x:Bind ViewModel.PhoneNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                IsEnabled="{x:Bind ViewModel.IsPhoneInputEnabled, Mode=OneWay}"/>
                            <Button Content="Получить код" Command="{x:Bind ViewModel.SendPhoneCodeCommand}" Style="{ThemeResource AccentButtonStyle}"
                                Visibility="{x:Bind ViewModel.IsSendCodeButtonVisible, Mode=OneWay}"/>
                            <HyperlinkButton Content="Настройки подключения" Click="OnProxySettingsClick" IsEnabled="{x:Bind ViewModel.IsReady, Mode=OneWay}"/>
                            <StackPanel Visibility="{x:Bind ViewModel.IsCodeInputVisible, Mode=OneWay}" Spacing="10">
                                <TextBox x:Name="CodeInput" Header="Код подтверждения" InputScope="Number"
                                    Text="{x:Bind ViewModel.PhoneCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                <Button Content="Подтвердить код" Command="{x:Bind ViewModel.SubmitPhoneCodeCommand}" Style="{ThemeResource AccentButtonStyle}"/>
                                <Button Content="Изменить номер или запросить новый код" Command="{x:Bind ViewModel.SwitchToPhoneModeCommand}"/>
                            </StackPanel>
                            <Button Content="Вернуться к QR-коду" Command="{x:Bind ViewModel.SwitchToQrModeCommand}"/>
                        </StackPanel>
                        <StackPanel Visibility="{x:Bind ViewModel.Is2FaMode, Mode=OneWay}" Spacing="12">
                            <TextBlock Text="Облачный пароль Telegram" Style="{ThemeResource SubtitleTextBlockStyle}" TextWrapping="Wrap"/>
                            <PasswordBox x:Name="PasswordInput" Header="Пароль двухэтапной аутентификации"
                                         Password="{x:Bind ViewModel.TwoFactorPassword, Mode=TwoWay}"/>
                            <Button Content="Войти" Command="{x:Bind ViewModel.Submit2FaCommand}" Style="{ThemeResource AccentButtonStyle}"/>
                            <Button Content="Вернуться к QR-коду" Command="{x:Bind ViewModel.SwitchToQrModeCommand}"/>
                        </StackPanel>
                        <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" Style="{StaticResource SupportingText}"
                                   Visibility="{x:Bind ViewModel.HasStatusMessage, Mode=OneWay}" AutomationProperties.LiveSetting="Polite"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
