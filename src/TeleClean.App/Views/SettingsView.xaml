<Page x:Class="TeleClean.App.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Background="{ThemeResource WorkspaceBrush}" VerticalScrollBarVisibility="Auto"
        HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
        HorizontalContentAlignment="Stretch">
        <StackPanel Spacing="14" Padding="24,20" HorizontalAlignment="Stretch">
            <StackPanel Spacing="4">
                <TextBlock Text="Настройки" Style="{StaticResource WorkspaceTitle}" AutomationProperties.HeadingLevel="Level1"/>
                <TextBlock Text="Оформление, скорость запросов и подключение к Telegram." Style="{StaticResource SupportingText}"/>
            </StackPanel>
            <InfoBar IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}" Severity="Error"
                Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" IsClosable="False"/>
            <InfoBar IsOpen="{x:Bind ViewModel.HasStatusMessage, Mode=OneWay}" Severity="Success"
                Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" IsClosable="False"/>

            <Border Style="{StaticResource WorkspacePanel}" Padding="20">
                <StackPanel Spacing="13">
                    <TextBlock Text="Оформление" Style="{ThemeResource SubtitleTextBlockStyle}" AutomationProperties.HeadingLevel="Level2"/>
                    <ComboBox Header="Цветовая тема" MinWidth="200" SelectedIndex="{x:Bind ViewModel.SelectedThemeIndex, Mode=TwoWay}">
                        <ComboBoxItem Content="Как в Windows"/><ComboBoxItem Content="Светлая"/><ComboBoxItem Content="Тёмная"/>
                    </ComboBox>
                    <ComboBox Header="Материал панели навигации" MinWidth="200" SelectedIndex="{x:Bind ViewModel.SelectedBackdropIndex, Mode=TwoWay}">
                        <ComboBoxItem Content="Mica"/><ComboBoxItem Content="Mica Alt"/><ComboBoxItem Content="Акрил"/>
                    </ComboBox>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource WorkspacePanel}" Padding="20">
                <StackPanel Spacing="10">
                    <TextBlock Text="Массовые операции" Style="{ThemeResource SubtitleTextBlockStyle}" AutomationProperties.HeadingLevel="Level2"/>
                    <Slider Header="Пауза между запросами" AutomationProperties.Name="Пауза между запросами, секунды"
                        Minimum="1" Maximum="10" StepFrequency="0.5" Value="{x:Bind ViewModel.DelayBetweenRequests, Mode=TwoWay}"/>
                    <TextBlock Text="{x:Bind ViewModel.DelaySecondsText, Mode=OneWay}" Style="{StaticResource SupportingText}"/>
                </StackPanel>
            </Border>

            <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Header="Подключение и API Telegram">
                <StackPanel Spacing="12">
                    <TextBlock Text="Изменения подключения применяются при следующем запуске приложения." Style="{StaticResource SupportingText}"/>
                    <PasswordBox Header="Ссылка MTProxy" Password="{x:Bind ViewModel.ProxyUrl, Mode=TwoWay}" PasswordRevealMode="Peek"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Сохранить прокси" Command="{x:Bind ViewModel.SaveProxyCommand}"/>
                        <Button Content="Отключить" Command="{x:Bind ViewModel.ClearProxyCommand}"/>
                    </StackPanel>
                    <NumberBox Header="API ID" Minimum="0" Maximum="2147483647" Value="{x:Bind ViewModel.ApiId, Mode=TwoWay}"/>
                    <PasswordBox Header="API Hash" Password="{x:Bind ViewModel.ApiHash, Mode=TwoWay}"/>
                    <Button Content="Сохранить ключи" Command="{x:Bind ViewModel.SaveApiKeysCommand}"/>
                </StackPanel>
            </Expander>

            <Border Style="{StaticResource WorkspacePanel}" Padding="20">
                <StackPanel Spacing="10">
                    <TextBlock Text="Данные и сессия" Style="{ThemeResource SubtitleTextBlockStyle}" AutomationProperties.HeadingLevel="Level2"/>
                    <TextBlock Text="Выход из аккаунта завершит сессию TeleClean на этом устройстве." Style="{StaticResource SupportingText}"/>
                    <Button Content="Очистить кэш аватаров" Command="{x:Bind ViewModel.ClearAvatarCacheCommand}"/>
                    <Button Content="Выйти из аккаунта" Click="OnConfirmLogout"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
