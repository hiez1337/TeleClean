<Page x:Class="TeleClean.App.Views.ProgressView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:model="using:TeleClean.Core.Models"
    xmlns:controls="using:TeleClean.App.Controls">
    <Grid x:Name="ProgressRoot" Background="Transparent" Padding="20,12,20,16" SizeChanged="OnProgressSizeChanged">
        <Grid x:Name="ContentContainer" HorizontalAlignment="Stretch" MaxWidth="1540" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Row 0: Header -->
            <Grid Grid.Row="0" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2">
                    <TextBlock Text="Операции" Style="{StaticResource PageTitleStyle}" AutomationProperties.HeadingLevel="Level1"/>
                    <TextBlock Text="Ход выполнения и подробный журнал последней массовой операции." Style="{StaticResource SupportingTextStyle}"/>
                </StackPanel>
                <Button Grid.Column="1" VerticalAlignment="Center" Click="OnReturnToDialogs">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <FontIcon Glyph="&#xE72B;" FontSize="13"/>
                        <TextBlock Text="К списку"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Empty State (No Operation Started Yet) -->
            <Border Grid.Row="1"
                    Style="{StaticResource CardPanelStyle}"
                    Padding="28,36"
                    Visibility="{x:Bind ViewModel.HasStarted, Converter={StaticResource InvertedBoolToVis}, Mode=OneWay}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420" Spacing="12">
                    <Border Width="52" Height="52" CornerRadius="26" Background="{ThemeResource BrandSubtleBrush}" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE9D5;" FontSize="22" Foreground="{ThemeResource BrandTextBrush}"/>
                    </Border>
                    <TextBlock Text="Операций пока нет" Style="{StaticResource SectionTitleStyle}" TextAlignment="Center" AutomationProperties.HeadingLevel="Level2"/>
                    <TextBlock Text="Выберите диалоги в любой категории и нажмите «Проверить выбор», чтобы безопасно запустить массовую обработку."
                               Style="{StaticResource SupportingTextStyle}" TextAlignment="Center"/>
                    <Button Content="Перейти к списку диалогов"
                            Style="{ThemeResource AccentButtonStyle}"
                            HorizontalAlignment="Center"
                            Margin="0,4,0,0"
                            Click="OnReturnToDialogs"/>
                </StackPanel>
            </Border>

            <!-- Active / Finished Operations Layout (Stacked on standard, 2-Column Split on wide/fullscreen) -->
            <Grid x:Name="DashboardGrid"
                  Grid.Row="1"
                  Visibility="{x:Bind ViewModel.HasStarted, Mode=OneWay}"
                  RowSpacing="12"
                  ColumnSpacing="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="SummaryColumn" Width="*"/>
                    <ColumnDefinition x:Name="JournalColumn" Width="0"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="SummaryRow" Height="Auto"/>
                    <RowDefinition x:Name="JournalRow" Height="*"/>
                </Grid.RowDefinitions>

                <!-- Progress & Metrics Card -->
                <Border x:Name="SummaryCard"
                        Grid.Row="0" Grid.Column="0"
                        Style="{StaticResource CardPanelStyle}"
                        Padding="20,16">
                    <StackPanel Spacing="12">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                <controls:StatusBadge Text="{x:Bind ViewModel.StateBadgeText, Mode=OneWay}"
                                                      Tone="{x:Bind ViewModel.StateTone, Mode=OneWay}"
                                                      ShowDot="True"/>
                                <TextBlock Text="{x:Bind ViewModel.ProgressPercentageText, Mode=OneWay}"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           Typography.NumeralAlignment="Tabular"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <Border Grid.Column="1"
                                    Background="{ThemeResource CardSurfaceSubtleBrush}"
                                    BorderBrush="{ThemeResource CardBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10,4"
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE916;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Text="{x:Bind ViewModel.ElapsedTimeText, Mode=OneWay}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Typography.NumeralAlignment="Tabular"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <TextBlock Text="{x:Bind ViewModel.CurrentStatusDescription, Mode=OneWay}"
                                   Style="{StaticResource SupportingTextStyle}"
                                   MaxLines="2"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTipService.ToolTip="{x:Bind ViewModel.CurrentStatusDescription, Mode=OneWay}"
                                   AutomationProperties.LiveSetting="Polite"/>

                        <ProgressBar Maximum="100"
                                     Value="{x:Bind ViewModel.ProgressPercentage, Mode=OneWay}"
                                     IsIndeterminate="{x:Bind ViewModel.IsWaitingOnRateLimit, Mode=OneWay}"
                                     AutomationProperties.Name="Прогресс обработки"/>

                        <!-- Stat Tiles -->
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Style="{StaticResource SubtleTileStyle}">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Обработано" Style="{StaticResource RowMetadataStyle}"/>
                                    <TextBlock Text="{x:Bind ViewModel.ProgressStepShortText, Mode=OneWay}"
                                               FontSize="18" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource SubtleTileStyle}">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Успешно" Style="{StaticResource RowMetadataStyle}"/>
                                    <TextBlock Text="{x:Bind ViewModel.SuccessCount, Mode=OneWay}"
                                               FontSize="18" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular"
                                               Foreground="{ThemeResource StatusSuccessFgBrush}"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource SubtleTileStyle}">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Ошибок" Style="{StaticResource RowMetadataStyle}"/>
                                    <Grid>
                                        <TextBlock Text="{x:Bind ViewModel.ErrorCount, Mode=OneWay}"
                                                   Visibility="{x:Bind ViewModel.HasErrors, Mode=OneWay}"
                                                   FontSize="18" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular"
                                                   Foreground="{ThemeResource StatusDangerFgBrush}"/>
                                        <TextBlock Text="0"
                                                   Visibility="{x:Bind ViewModel.HasErrors, Converter={StaticResource InvertedBoolToVis}, Mode=OneWay}"
                                                   FontSize="18" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <InfoBar IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                                 Severity="Error"
                                 IsClosable="False"
                                 Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"/>

                        <!-- Operation Controls -->
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2,0,0">
                            <Button Command="{x:Bind ViewModel.TogglePauseCommand}"
                                    IsEnabled="{x:Bind ViewModel.CanTogglePause, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <FontIcon Glyph="{x:Bind ViewModel.PauseGlyph, Mode=OneWay}" FontSize="12"/>
                                    <TextBlock Text="{x:Bind ViewModel.PauseButtonText, Mode=OneWay}"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource DestructiveButtonStyle}"
                                    Command="{x:Bind ViewModel.StopCommand}"
                                    IsEnabled="{x:Bind ViewModel.CanStop, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <FontIcon Glyph="&#xE71A;" FontSize="12"/>
                                    <TextBlock Text="Остановить"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Live Operation Journal -->
                <Border x:Name="JournalCard"
                        Grid.Row="1" Grid.Column="0"
                        Style="{StaticResource CardPanelStyle}"
                        Padding="16,14">
                    <Grid RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Text="Журнал" Style="{StaticResource SectionTitleStyle}" AutomationProperties.HeadingLevel="Level2"/>
                                <Border Background="{ThemeResource StatusNeutralBgBrush}" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind ViewModel.LogCount, Mode=OneWay}"
                                               FontSize="12" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular"
                                               Foreground="{ThemeResource StatusNeutralFgBrush}"/>
                                </Border>
                            </StackPanel>

                            <TextBlock Grid.Column="1"
                                       Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                                       Visibility="{x:Bind ViewModel.HasStatusMessage, Mode=OneWay}"
                                       FontSize="12"
                                       Foreground="{ThemeResource StatusSuccessFgBrush}"
                                       VerticalAlignment="Center"
                                       AutomationProperties.LiveSetting="Polite"/>

                            <Button Grid.Column="2"
                                    Command="{x:Bind ViewModel.CopyLogCommand}"
                                    IsEnabled="{x:Bind ViewModel.HasLogs, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <FontIcon Glyph="&#xE8C8;" FontSize="12"/>
                                    <TextBlock Text="Копировать"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <ListView Grid.Row="1"
                                  ItemsSource="{x:Bind ViewModel.LogEntries, Mode=OneWay}"
                                  SelectionMode="None"
                                  AutomationProperties.Name="Журнал обработки">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="MinHeight" Value="0"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="model:BulkLogEntry">
                                    <Grid Padding="4,8" ColumnSpacing="10"
                                          BorderThickness="0,0,0,1" BorderBrush="{ThemeResource SubtleDividerBrush}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <controls:StatusBadge Text="{x:Bind Converter={StaticResource LogEntryToBadgeText}}"
                                                              Tone="{x:Bind Converter={StaticResource LogEntryToTone}}"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{x:Bind FormattedTime}"
                                                   Style="{StaticResource RowMetadataStyle}"
                                                   Typography.NumeralAlignment="Tabular"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2"
                                                   Text="{x:Bind Message, Converter={StaticResource CleanLogMessage}}"
                                                   FontSize="13"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <TextBlock Grid.Row="1"
                                   Margin="4,8"
                                   Text="Записи появятся после начала обработки."
                                   Style="{StaticResource SupportingTextStyle}"
                                   Visibility="{x:Bind ViewModel.HasLogs, Converter={StaticResource InvertedBoolToVis}, Mode=OneWay}"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>
