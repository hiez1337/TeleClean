<Page x:Class="TeleClean.App.Views.ProgressView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:model="using:TeleClean.Core.Models">
    <Grid Background="{ThemeResource WorkspaceBrush}" Padding="24,20" RowSpacing="12">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Spacing="4">
            <TextBlock Text="Операции" Style="{StaticResource WorkspaceTitle}" AutomationProperties.HeadingLevel="Level1"/>
            <TextBlock Text="Ход обработки и результаты последней операции." Style="{StaticResource SupportingText}"/>
        </StackPanel>
        <Border Grid.Row="1" Style="{StaticResource WorkspacePanel}" Padding="16"
                Visibility="{x:Bind ViewModel.HasStarted, Converter={StaticResource InvertedBoolToVis}, Mode=OneWay}">
            <StackPanel Spacing="8">
                <TextBlock Text="Операций пока нет" Style="{StaticResource SectionTitle}" AutomationProperties.HeadingLevel="Level2"/>
                <TextBlock Text="Выберите диалоги в списке и проверьте состав операции перед запуском." Style="{StaticResource SupportingText}"/>
                <Button Content="К списку диалогов" Click="OnReturnToDialogs"/>
            </StackPanel>
        </Border>
        <Border Grid.Row="1" Visibility="{x:Bind ViewModel.HasStarted, Mode=OneWay}" Style="{StaticResource WorkspacePanel}" Padding="16">
            <StackPanel Spacing="9">
                <TextBlock Text="{x:Bind ViewModel.StateBadgeText, Mode=OneWay}" Style="{StaticResource SectionTitle}" AutomationProperties.HeadingLevel="Level2"/>
                <TextBlock Text="{x:Bind ViewModel.CurrentStatusDescription, Mode=OneWay}" Style="{StaticResource SupportingText}"
                    MaxLines="3" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind ViewModel.CurrentStatusDescription, Mode=OneWay}"
                    AutomationProperties.LiveSetting="Polite"/>
                <ProgressBar Maximum="100" Value="{x:Bind ViewModel.ProgressPercentage, Mode=OneWay}"
                             IsIndeterminate="{x:Bind ViewModel.IsWaitingOnRateLimit, Mode=OneWay}" AutomationProperties.Name="Прогресс обработки"/>
                <TextBlock Text="{x:Bind ViewModel.ProgressStepText, Mode=OneWay}" Style="{StaticResource SupportingText}"/>
                <TextBlock Text="{x:Bind ViewModel.SuccessErrorCounterText, Mode=OneWay}" FontWeight="SemiBold" TextWrapping="Wrap"
                    Typography.NumeralAlignment="Tabular"/>
                <InfoBar IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}" Severity="Error" IsClosable="False" Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"/>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Button Content="{x:Bind ViewModel.PauseButtonText, Mode=OneWay}" Command="{x:Bind ViewModel.TogglePauseCommand}"
                            ContentTemplate="{StaticResource WrappingLabel}" HorizontalAlignment="Stretch"
                            IsEnabled="{x:Bind ViewModel.CanTogglePause, Mode=OneWay}"/>
                    <Button Grid.Column="1" Content="Остановить" Command="{x:Bind ViewModel.StopCommand}" HorizontalAlignment="Stretch"
                        ContentTemplate="{StaticResource WrappingLabel}" IsEnabled="{x:Bind ViewModel.CanStop, Mode=OneWay}"/>
                    <Button Grid.Column="2" Content="К списку" Click="OnReturnToDialogs" HorizontalAlignment="Stretch"
                        ContentTemplate="{StaticResource WrappingLabel}"/>
                </Grid>
            </StackPanel>
        </Border>
        <Border Grid.Row="2" Visibility="{x:Bind ViewModel.HasStarted, Mode=OneWay}" Style="{StaticResource WorkspacePanel}" Padding="12">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Журнал" VerticalAlignment="Center" Style="{StaticResource SectionTitle}" AutomationProperties.HeadingLevel="Level2"/>
                    <Button Grid.Column="1" HorizontalAlignment="Right" Content="Копировать" Command="{x:Bind ViewModel.CopyLogCommand}"
                            ContentTemplate="{StaticResource WrappingLabel}"
                            IsEnabled="{x:Bind ViewModel.HasLogs, Mode=OneWay}"/>
                </Grid>
                <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.LogEntries, Mode=OneWay}" SelectionMode="None"
                    AutomationProperties.Name="Журнал обработки">
                    <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="model:BulkLogEntry">
                            <Grid ColumnSpacing="12" Padding="0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind FormattedTime}" Style="{StaticResource RowMetadata}" Typography.NumeralAlignment="Tabular"/>
                                <TextBlock Grid.Column="1" Text="{x:Bind Message}" TextWrapping="Wrap"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock Grid.Row="1" Margin="8" Text="Записи появятся после запуска обработки."
                    Style="{StaticResource SupportingText}" Visibility="{x:Bind ViewModel.HasLogs, Converter={StaticResource InvertedBoolToVis}, Mode=OneWay}"/>
            </Grid>
        </Border>
    </Grid>
</Page>
