<Page
    x:Class="TeleClean.App.Views.ProgressView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:TeleClean.App.Converters"
    xmlns:models="using:TeleClean.Core.Models"
    xmlns:vm="using:TeleClean.App.ViewModels"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:TimestampConverter x:Key="TimeConverter" />
        <converters:BulkStateToBackgroundBrushConverter x:Key="StateToBgConverter" />
        <converters:BulkStateToForegroundBrushConverter x:Key="StateToFgConverter" />
        <converters:StatusBadgeBgConverter x:Key="ResultToBgConverter" />
        <converters:StatusBadgeConverter x:Key="ResultToFgConverter" />
        <converters:InvertedBooleanToVisibilityConverter x:Key="InvertedBoolToVis" />
    </Page.Resources>

    <Grid Padding="24,14,24,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <!-- 0: Compact Minimalist Progress Header -->
            <RowDefinition Height="Auto" />
            <!-- 1: Structured Operation Log Table -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Compact Minimalist Progress Header Card -->
        <Border
            Grid.Row="0"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="16,12">

            <Grid RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Row 0: Title, Status Badge & Controls -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Title & State Badge -->
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <TextBlock Text="Операции" FontWeight="SemiBold" FontSize="16" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                        
                        <Border
                            Background="{x:Bind ViewModel.CurrentState, Converter={StaticResource StateToBgConverter}, Mode=OneWay}"
                            CornerRadius="4"
                            Padding="8,2"
                            VerticalAlignment="Center">
                            <TextBlock
                                Text="{x:Bind ViewModel.StateBadgeText, Mode=OneWay}"
                                Foreground="{x:Bind ViewModel.CurrentState, Converter={StaticResource StateToFgConverter}, Mode=OneWay}"
                                FontWeight="SemiBold"
                                FontSize="11" />
                        </Border>
                    </StackPanel>

                    <!-- Elapsed Time, Percentage & Action Buttons -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <!-- Elapsed Stopwatch Timer -->
                        <Border Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="4" Padding="8,4" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE823;" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock
                                    Text="{x:Bind ViewModel.ElapsedTimeText, Mode=OneWay}"
                                    FontFamily="Cascadia Code, Consolas"
                                    FontSize="11.5"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- Percentage Text -->
                        <Border Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="4" Padding="8,4" VerticalAlignment="Center">
                            <TextBlock
                                Text="{x:Bind ViewModel.ProgressPercentageText, Mode=OneWay}"
                                FontWeight="SemiBold"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        </Border>

                        <!-- Pause / Resume Button -->
                        <Button
                            Content="{x:Bind ViewModel.PauseButtonText, Mode=OneWay}"
                            Command="{x:Bind ViewModel.TogglePauseCommand}"
                            IsEnabled="{x:Bind ViewModel.CanTogglePause, Mode=OneWay}"
                            Height="30"
                            Padding="10,0"
                            CornerRadius="4" />

                        <!-- Stop Button -->
                        <Button
                            Content="⏹ Прервать"
                            Command="{x:Bind ViewModel.StopCommand}"
                            IsEnabled="{x:Bind ViewModel.CanStop, Mode=OneWay}"
                            Style="{ThemeResource AccentButtonStyle}"
                            Height="30"
                            Padding="10,0"
                            CornerRadius="4" />

                        <!-- Copy Log Button -->
                        <Button
                            Content="📋 Скопировать лог"
                            Command="{x:Bind ViewModel.CopyLogCommand}"
                            Height="30"
                            Padding="10,0"
                            CornerRadius="4" />
                    </StackPanel>
                </Grid>

                <!-- Row 1: Sleek Progress Bar -->
                <ProgressBar
                    Grid.Row="1"
                    Minimum="0"
                    Maximum="{x:Bind ViewModel.TotalCount, Mode=OneWay}"
                    Value="{x:Bind ViewModel.CurrentIndex, Mode=OneWay}"
                    IsIndeterminate="{x:Bind ViewModel.IsWaitingOnRateLimit, Mode=OneWay}"
                    Height="6"
                    CornerRadius="3" />

                <!-- Row 2: Progress Subtitle & Step Details -->
                <Grid Grid.Row="2">
                    <TextBlock
                        Text="{x:Bind ViewModel.CurrentStatusDescription, Mode=OneWay}"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextTrimming="CharacterEllipsis"
                        VerticalAlignment="Center" />

                    <TextBlock
                        Text="{x:Bind ViewModel.SuccessErrorCounterText, Mode=OneWay}"
                        FontSize="11.5"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center" />
                </Grid>
            </Grid>
        </Border>

        <!-- Structured Operation Log Table -->
        <Border
            Grid.Row="1"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">

            <Grid>
                <Grid.RowDefinitions>
                    <!-- Log Table Header -->
                    <RowDefinition Height="Auto" />
                    <!-- Log Entries List -->
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Column Headers matching the dialogs table style -->
                <Border
                    Grid.Row="0"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="0,0,0,1"
                    Height="38"
                    Padding="12,0">

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100" /> <!-- [Время] -->
                            <ColumnDefinition Width="*" />   <!-- [Диалог] -->
                            <ColumnDefinition Width="180" /> <!-- [Действие] -->
                            <ColumnDefinition Width="130" /> <!-- [Статус] -->
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="[Время]" Style="{StaticResource TableHeaderTextStyle}" />
                        <TextBlock Grid.Column="1" Text="[Диалог]" Style="{StaticResource TableHeaderTextStyle}" />
                        <TextBlock Grid.Column="2" Text="[Действие]" Style="{StaticResource TableHeaderTextStyle}" />
                        <TextBlock Grid.Column="3" Text="[Статус]" Style="{StaticResource TableHeaderTextStyle}" />
                    </Grid>
                </Border>

                <!-- High-Performance Virtualized Operation Log Rows -->
                <ListView
                    Grid.Row="1"
                    ItemsSource="{x:Bind ViewModel.LogEntries, Mode=OneWay}"
                    SelectionMode="None"
                    Padding="0">

                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsStackPanel AreStickyGroupHeadersEnabled="False" CacheLength="4.0" />
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>

                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:BulkLogEntry">
                            <Border
                                Height="38"
                                BorderThickness="0,0,0,1"
                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                Background="Transparent">

                                <Grid ColumnSpacing="12" Padding="12,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100" /> <!-- [Время] -->
                                        <ColumnDefinition Width="*" />   <!-- [Диалог] -->
                                        <ColumnDefinition Width="180" /> <!-- [Действие] -->
                                        <ColumnDefinition Width="130" /> <!-- [Статус] -->
                                    </Grid.ColumnDefinitions>

                                    <!-- Timestamp -->
                                    <TextBlock
                                        Grid.Column="0"
                                        Text="{x:Bind FormattedTime}"
                                        FontFamily="Cascadia Code, Consolas"
                                        FontSize="11.5"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        VerticalAlignment="Center" />

                                    <!-- Dialog Title -->
                                    <TextBlock
                                        Grid.Column="1"
                                        Text="{x:Bind Title}"
                                        FontWeight="Medium"
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                        TextTrimming="CharacterEllipsis"
                                        VerticalAlignment="Center" />

                                    <!-- Action Name -->
                                    <TextBlock
                                        Grid.Column="2"
                                        Text="{x:Bind Action}"
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextTrimming="CharacterEllipsis"
                                        VerticalAlignment="Center" />

                                    <!-- Status Badge -->
                                    <Border
                                        Grid.Column="3"
                                        Background="{x:Bind Result, Converter={StaticResource ResultToBgConverter}}"
                                        CornerRadius="4"
                                        Padding="8,2"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center">
                                        <TextBlock
                                            Text="{x:Bind StatusText}"
                                            Foreground="{x:Bind Result, Converter={StaticResource ResultToFgConverter}}"
                                            FontWeight="SemiBold"
                                            FontSize="11" />
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Empty State Visual when no operations/logs -->
                <StackPanel
                    Grid.Row="1"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Spacing="8"
                    Visibility="{x:Bind ViewModel.Logs.Count, Converter={StaticResource InvertedBoolToVis}, Mode=OneWay}">
                    <FontIcon Glyph="&#xE823;" FontSize="36" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="Нет активных операций" FontWeight="SemiBold" FontSize="15" Foreground="{ThemeResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="Выберите диалоги на вкладках выше и нажмите «Выйти из выбранных»" FontSize="12.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
