<Page x:Class="TeleClean.App.Views.DialogsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:TeleClean.App.ViewModels" xmlns:controls="using:TeleClean.App.Controls">
    <Grid x:Name="Workspace" Background="{ThemeResource WorkspaceBrush}" Padding="18,12" RowSpacing="8" SizeChanged="OnWorkspaceSizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Spacing="2">
            <TextBlock Text="{x:Bind ViewModel.CurrentCategoryTitleWithCount, Mode=OneWay}"
                ToolTipService.ToolTip="{x:Bind ViewModel.CategoryHint, Mode=OneWay}"
                Style="{StaticResource WorkspaceTitle}" AutomationProperties.HeadingLevel="Level1"/>
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition x:Name="FilterColumn" Width="0"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBox x:Name="SearchBox" PlaceholderText="Название или @имя" AutomationProperties.Name="Поиск в категории"
                ToolTipService.ToolTip="Поиск в категории (Ctrl+F)" IsSpellCheckEnabled="False"
                Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                <TextBox.KeyboardAccelerators>
                    <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="OnSearchShortcut"/>
                </TextBox.KeyboardAccelerators>
            </TextBox>
            <Button Grid.Column="1" VerticalAlignment="Stretch" MinWidth="36" Padding="8,4"
                Command="{x:Bind ViewModel.LoadDialogsCommand}" IsEnabled="{x:Bind ViewModel.CanRefresh, Mode=OneWay}"
                AutomationProperties.Name="Обновить список" ToolTipService.ToolTip="Обновить список (F5)">
                <FontIcon Glyph="&#xE72C;" FontSize="16"/>
            </Button>
            <Grid x:Name="FilterBar" Grid.Row="1" Grid.ColumnSpan="2" ColumnSpacing="8" Margin="0,6,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <ComboBox MinWidth="0" HorizontalAlignment="Stretch" ItemTemplate="{StaticResource WrappingLabel}" AutomationProperties.Name="Фильтр" ToolTipService.ToolTip="Фильтр"
                    ItemsSource="{x:Bind ViewModel.FilterOptions}" SelectedIndex="{x:Bind ViewModel.SelectedFilterIndex, Mode=TwoWay}"/>
                <ComboBox Grid.Column="1" MinWidth="0" HorizontalAlignment="Stretch" ItemTemplate="{StaticResource WrappingLabel}" AutomationProperties.Name="Сортировка" ToolTipService.ToolTip="Сортировка"
                    ItemsSource="{x:Bind ViewModel.SortOptions}" SelectedIndex="{x:Bind ViewModel.SelectedSortIndex, Mode=TwoWay}"/>
            </Grid>
        </Grid>

        <StackPanel Grid.Row="2" Spacing="6">
            <InfoBar Title="Список недоступен" Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                Severity="Error" IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}" IsClosable="False"/>
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Visibility="{x:Bind ViewModel.HasStatusMessage, Mode=OneWay}" Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                    VerticalAlignment="Center" Style="{StaticResource SupportingText}" AutomationProperties.LiveSetting="Polite"/>
                <HyperlinkButton Grid.Column="1" Content="Сбросить" Visibility="{x:Bind ViewModel.HasFilters, Mode=OneWay}"
                    AutomationProperties.Name="Сбросить поиск и фильтр" ToolTipService.ToolTip="Сбросить поиск и фильтр"
                    Command="{x:Bind ViewModel.ClearFiltersCommand}" Padding="4,0"/>
            </Grid>
            <ProgressBar IsIndeterminate="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}"/>
        </StackPanel>

        <Border Grid.Row="3" Style="{StaticResource WorkspacePanel}">
            <Grid Padding="6,2">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid MinHeight="40" Padding="8,0" ColumnSpacing="8"
                      BorderThickness="0,0,0,1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32"/><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox x:Name="SelectVisible" MinWidth="0" Padding="0" IsThreeState="False" ContentTemplate="{StaticResource WrappingLabel}"
                        AutomationProperties.Name="Выбрать видимые" ToolTipService.ToolTip="Выбрать видимые"
                        IsChecked="{x:Bind ViewModel.IsAllSelectedInView, Mode=OneWay}"
                        IsEnabled="{x:Bind ViewModel.CanSelectVisible, Mode=OneWay}" Click="OnSelectVisible"/>
                    <Button x:Name="NameHeading" Grid.Column="2" Style="{StaticResource ColumnSortButton}" HorizontalAlignment="Left"
                        Content="{x:Bind ViewModel.TitleSortHeader, Mode=OneWay}" Command="{x:Bind ViewModel.SortByTitleCommand}"
                        ToolTipService.ToolTip="По названию от А до Я"/>
                    <Grid x:Name="ComparisonHeading" Grid.Column="3" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="86"/><ColumnDefinition Width="106"/><ColumnDefinition Width="132"/><ColumnDefinition Width="112"/>
                        </Grid.ColumnDefinitions>
                        <Button Style="{StaticResource ColumnSortButton}" Content="{x:Bind ViewModel.ParticipantsSortHeader, Mode=OneWay}" Command="{x:Bind ViewModel.SortBySubscribersCommand}" ToolTipService.ToolTip="По числу участников, сначала больше"/>
                        <Button Grid.Column="1" Style="{StaticResource ColumnSortButton}" Content="{x:Bind ViewModel.UnreadSortHeader, Mode=OneWay}" Command="{x:Bind ViewModel.SortByUnreadCommand}" ToolTipService.ToolTip="По числу непрочитанных, сначала больше"/>
                        <Button Grid.Column="2" Style="{StaticResource ColumnSortButton}" Content="{x:Bind ViewModel.ActivitySortHeader, Mode=OneWay}" Command="{x:Bind ViewModel.SortByActivityCommand}" ToolTipService.ToolTip="По последней активности, сначала новые"/>
                        <TextBlock Grid.Column="3" Text="Статус" TextAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap"/>
                    </Grid>
                </Grid>
                <ListView Grid.Row="1" SelectionMode="None" ItemsSource="{x:Bind ViewModel.VisibleDialogs, Mode=OneWay}"
                    AutomationProperties.Name="Диалоги текущей категории">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="AutomationProperties.Name" Value="{Binding Title}"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:DialogItemViewModel">
                            <Grid MinHeight="49" ColumnSpacing="8" Padding="8,4" CornerRadius="5" Tapped="OnRowTapped"
                                  Background="Transparent">
                                <Grid.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="Сведения о диалоге" Tag="{x:Bind}" Click="OnShowDialogDetails"/>
                                    </MenuFlyout>
                                </Grid.ContextFlyout>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32"/><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.ColumnSpan="4" Margin="-8,0" CornerRadius="5"
                                    BorderBrush="{ThemeResource SelectionStrokeBrush}" BorderThickness="2,1,1,1"
                                    Background="{ThemeResource SelectionBrush}" IsHitTestVisible="False" Visibility="{x:Bind IsSelected, Mode=OneWay}"/>
                                <CheckBox MinWidth="0" Padding="0" IsChecked="{x:Bind IsSelected, Mode=TwoWay}" ToolTipService.ToolTip="{x:Bind Title}"
                                          IsEnabled="{x:Bind CanToggle, Mode=OneWay}" AutomationProperties.Name="{x:Bind Title}"/>
                                <controls:AvatarControl Grid.Column="1" Width="30" Height="30" VerticalAlignment="Center"
                                    Title="{x:Bind Title}" AvatarPath="{x:Bind AvatarLocalPath, Mode=OneWay}" IsDimmed="{x:Bind IsDimmed, Mode=OneWay}"/>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" MaxLines="2" TextWrapping="Wrap"
                                        TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Title}"/>
                                    <TextBlock Text="{x:Bind CompactMetrics}" Style="{StaticResource RowMetadata}" Visibility="{x:Bind ShowCompactDetails, Mode=OneWay}"
                                        Typography.NumeralAlignment="Tabular"/>
                                    <TextBlock Text="{x:Bind DisplayStatus, Mode=OneWay}" Style="{StaticResource RowMetadata}" Visibility="{x:Bind ShowCompactDetails, Mode=OneWay}"/>
                                    <TextBlock Text="{x:Bind UsernameFormatted}" Style="{StaticResource RowMetadata}" TextWrapping="NoWrap"
                                        Visibility="{x:Bind ShowComparisonUsername, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind UsernameFormatted}"/>
                                </StackPanel>
                                <Grid Grid.Column="3" ColumnSpacing="8" Visibility="{x:Bind ShowComparison, Mode=OneWay}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="86"/><ColumnDefinition Width="106"/><ColumnDefinition Width="132"/><ColumnDefinition Width="112"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind ParticipantsText}" Style="{StaticResource NumericCell}"/>
                                    <TextBlock Grid.Column="1" Text="{x:Bind UnreadCount}" Style="{StaticResource NumericCell}"/>
                                    <TextBlock Grid.Column="2" Text="{x:Bind ActivityDateText}" Style="{StaticResource NumericCell}"/>
                                    <TextBlock Grid.Column="3" Text="{x:Bind DisplayStatus, Mode=OneWay}" TextAlignment="Right"
                                        VerticalAlignment="Center" Style="{StaticResource RowMetadata}"/>
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <StackPanel Grid.Row="1" Visibility="{x:Bind ViewModel.ShowEmpty, Mode=OneWay}" MaxWidth="330"
                    VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8" Margin="12">
                    <FontIcon Glyph="&#xE721;" FontSize="23" Foreground="{ThemeResource BrandBrush}"/>
                    <TextBlock Text="{x:Bind ViewModel.EmptyTitle, Mode=OneWay}" Style="{StaticResource SectionTitle}" TextAlignment="Center"/>
                    <TextBlock Text="{x:Bind ViewModel.EmptyHint, Mode=OneWay}" Style="{StaticResource SupportingText}" TextAlignment="Center"/>
                    <Button Content="Сбросить фильтры" ContentTemplate="{StaticResource WrappingLabel}" HorizontalAlignment="Center" Command="{x:Bind ViewModel.ClearFiltersCommand}"
                        Visibility="{x:Bind ViewModel.HasFilters, Mode=OneWay}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="4" Style="{StaticResource WorkspacePanel}" Padding="10,6">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="ClearColumn" Width="Auto"/><ColumnDefinition x:Name="ReviewColumn" Width="Auto"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock x:Name="SelectionSummary" Text="{x:Bind ViewModel.SelectionCounterText, Mode=OneWay}" FontWeight="SemiBold"
                    Typography.NumeralAlignment="Tabular" VerticalAlignment="Center" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                <Button x:Name="ClearSelection" Grid.Column="1" Content="Снять выбор" Command="{x:Bind ViewModel.DeselectAllCommand}"
                    VerticalAlignment="Center" ContentTemplate="{StaticResource WrappingLabel}" Visibility="{x:Bind ViewModel.CanExecuteAction, Mode=OneWay}"/>
                <Button x:Name="ReviewSelection" Grid.Column="2" Content="{x:Bind ViewModel.ActionButtonText, Mode=OneWay}"
                    ContentTemplate="{StaticResource WrappingLabel}" HorizontalAlignment="Right" VerticalAlignment="Center"
                    Style="{ThemeResource AccentButtonStyle}" IsEnabled="{x:Bind ViewModel.CanExecuteAction, Mode=OneWay}"
                    Click="OnReviewSelection"/>
            </Grid>
        </Border>
    </Grid>
</Page>
