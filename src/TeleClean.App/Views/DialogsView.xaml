<Page x:Class="TeleClean.App.Views.DialogsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:TeleClean.App.ViewModels"
    xmlns:controls="using:TeleClean.App.Controls">
    <Grid x:Name="Workspace" Background="Transparent" Padding="20,12,20,14" RowSpacing="10" SizeChanged="OnWorkspaceSizeChanged">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="OnSearchShortcut"/>
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Row 0: Category Header + Refresh Action -->
        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind ViewModel.CurrentCategoryTitle, Mode=OneWay}"
                               Style="{StaticResource PageTitleStyle}"
                               AutomationProperties.HeadingLevel="Level1"/>
                    <Border Background="{ThemeResource StatusNeutralBgBrush}"
                            CornerRadius="10"
                            Padding="9,2"
                            VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind ViewModel.CurrentCategoryCount, Mode=OneWay}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Typography.NumeralAlignment="Tabular"
                                   Foreground="{ThemeResource StatusNeutralFgBrush}"/>
                    </Border>
                </StackPanel>
                <TextBlock Text="{x:Bind ViewModel.CategoryHint, Mode=OneWay}"
                           Style="{StaticResource SupportingTextStyle}"
                           MaxLines="1"
                           TextTrimming="CharacterEllipsis"
                           ToolTipService.ToolTip="{x:Bind ViewModel.CategoryHint, Mode=OneWay}"/>
            </StackPanel>

            <Button x:Name="RefreshButton"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Command="{x:Bind ViewModel.LoadDialogsCommand}"
                    IsEnabled="{x:Bind ViewModel.CanRefresh, Mode=OneWay}"
                    AutomationProperties.Name="Обновить список"
                    ToolTipService.ToolTip="Обновить список (F5)">
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <FontIcon Glyph="&#xE72C;" FontSize="13"/>
                    <TextBlock x:Name="RefreshLabel" Text="Обновить" FontSize="13"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Row 1: Search, Filter, Sort, and Reset -->
        <Grid Grid.Row="1" ColumnSpacing="8" RowSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="FilterColumn" Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBox x:Name="SearchBox"
                     PlaceholderText="Поиск по названию или @имени…"
                     AutomationProperties.Name="Поиск в категории"
                     ToolTipService.ToolTip="Поиск в категории (Ctrl+F)"
                     IsSpellCheckEnabled="False"
                     Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

            <Grid x:Name="FilterBar" Grid.Column="1" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="FilterPickerColumn" Width="Auto"/>
                    <ColumnDefinition x:Name="SortPickerColumn" Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="FilterPicker"
                          MinWidth="148"
                          HorizontalAlignment="Stretch"
                          ItemTemplate="{StaticResource WrappingLabel}"
                          AutomationProperties.Name="Фильтр"
                          ToolTipService.ToolTip="Фильтр"
                          ItemsSource="{x:Bind ViewModel.FilterOptions}"
                          SelectedIndex="{x:Bind ViewModel.SelectedFilterIndex, Mode=TwoWay}"/>
                <ComboBox x:Name="SortPicker"
                          Grid.Column="1"
                          MinWidth="166"
                          HorizontalAlignment="Stretch"
                          ItemTemplate="{StaticResource WrappingLabel}"
                          AutomationProperties.Name="Сортировка"
                          ToolTipService.ToolTip="Сортировка"
                          ItemsSource="{x:Bind ViewModel.SortOptions}"
                          SelectedIndex="{x:Bind ViewModel.SelectedSortIndex, Mode=TwoWay}"/>
                <Button Grid.Column="2"
                        Visibility="{x:Bind ViewModel.HasFilters, Mode=OneWay}"
                        Command="{x:Bind ViewModel.ClearFiltersCommand}"
                        AutomationProperties.Name="Сбросить поиск и фильтр"
                        ToolTipService.ToolTip="Сбросить поиск и фильтр">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE711;" FontSize="11"/>
                        <TextBlock Text="Сбросить" FontSize="13"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>

        <!-- Row 2: Conditional Error & Loading Strip (collapsed when idle to preserve vertical space) -->
        <StackPanel Grid.Row="2" Spacing="6" Visibility="{x:Bind ViewModel.HasNotificationArea, Mode=OneWay}">
            <InfoBar Title="Список недоступен"
                     Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                     Severity="Error"
                     IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                     IsClosable="False"/>
            <ProgressBar IsIndeterminate="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                         Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}"/>
        </StackPanel>

        <!-- Row 3: Dialog Data Table Card -->
        <Border Grid.Row="3" Style="{StaticResource CardPanelStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Table Header -->
                <Grid MinHeight="38"
                      Padding="18,0,18,0"
                      ColumnSpacing="12"
                      Background="{ThemeResource TableHeaderBrush}"
                      CornerRadius="7,7,0,0"
                      BorderThickness="0,0,0,1"
                      BorderBrush="{ThemeResource SubtleDividerBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32"/>
                        <ColumnDefinition Width="36"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox x:Name="SelectVisible"
                              MinWidth="0"
                              Padding="0"
                              IsThreeState="False"
                              VerticalAlignment="Center"
                              AutomationProperties.Name="Выбрать видимые"
                              ToolTipService.ToolTip="Выбрать видимые"
                              IsChecked="{x:Bind ViewModel.IsAllSelectedInView, Mode=OneWay}"
                              IsEnabled="{x:Bind ViewModel.CanSelectVisible, Mode=OneWay}"
                              Click="OnSelectVisible"/>
                    <Button x:Name="NameHeading"
                            Grid.Column="2"
                            Style="{StaticResource ColumnSortButtonStyle}"
                            HorizontalAlignment="Left"
                            Margin="-6,0,0,0"
                            Content="{x:Bind ViewModel.TitleSortHeader, Mode=OneWay}"
                            Command="{x:Bind ViewModel.SortByTitleCommand}"
                            ToolTipService.ToolTip="По названию от А до Я"/>
                    <Grid x:Name="ComparisonHeading" Grid.Column="3" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="88"/>
                            <ColumnDefinition Width="104"/>
                            <ColumnDefinition Width="96"/>
                            <ColumnDefinition Width="108"/>
                        </Grid.ColumnDefinitions>
                        <Button Style="{StaticResource ColumnSortButtonStyle}"
                                Margin="0,0,-6,0"
                                Content="{x:Bind ViewModel.ParticipantsSortHeader, Mode=OneWay}"
                                Command="{x:Bind ViewModel.SortBySubscribersCommand}"
                                ToolTipService.ToolTip="По числу участников, сначала больше"/>
                        <Button Grid.Column="1"
                                Style="{StaticResource ColumnSortButtonStyle}"
                                Margin="0,0,-6,0"
                                Content="{x:Bind ViewModel.UnreadSortHeader, Mode=OneWay}"
                                Command="{x:Bind ViewModel.SortByUnreadCommand}"
                                ToolTipService.ToolTip="По числу непрочитанных, сначала больше"/>
                        <Button Grid.Column="2"
                                Style="{StaticResource ColumnSortButtonStyle}"
                                Margin="0,0,-6,0"
                                Content="{x:Bind ViewModel.ActivitySortHeader, Mode=OneWay}"
                                Command="{x:Bind ViewModel.SortByActivityCommand}"
                                ToolTipService.ToolTip="По последней активности, сначала новые"/>
                        <TextBlock Grid.Column="3"
                                   Text="Статус"
                                   TextAlignment="Right"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </Grid>
                </Grid>

                <!-- Virtualized Dialog Rows -->
                <ListView Grid.Row="1"
                          SelectionMode="None"
                          Padding="0,2"
                          ItemsSource="{x:Bind ViewModel.VisibleDialogs, Mode=OneWay}"
                          AutomationProperties.Name="Диалоги текущей категории">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="MinHeight" Value="0"/>
                            <Setter Property="AutomationProperties.Name" Value="{Binding Title}"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <ListViewItemPresenter
                                            ContentMargin="0"
                                            CornerRadius="6"
                                            SelectionIndicatorVisualEnabled="False"
                                            PointerOverBackground="{ThemeResource RowHoverBackgroundBrush}"
                                            PressedBackground="{ThemeResource RowHoverBackgroundBrush}"
                                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:DialogItemViewModel">
                            <Grid MinHeight="50"
                                  Background="Transparent"
                                  Tapped="OnRowTapped"
                                  Opacity="{x:Bind IsDimmed, Converter={StaticResource DimmedToOpacity}, Mode=OneWay}">
                                <Grid.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="Сведения о диалоге" Tag="{x:Bind}" Click="OnShowDialogDetails">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE946;"/></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="Копировать название" Tag="{x:Bind}" Click="OnCopyDialogTitle">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;"/></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </Grid.ContextFlyout>

                                <!-- Row Divider -->
                                <Border Height="1"
                                        VerticalAlignment="Bottom"
                                        Margin="18,0"
                                        Background="{ThemeResource SubtleDividerBrush}"
                                        IsHitTestVisible="False"/>

                                <!-- Selected Row Highlight + Left Accent Pill -->
                                <Border Margin="6,2,12,2"
                                        CornerRadius="6"
                                        Background="{ThemeResource RowSelectedBackgroundBrush}"
                                        BorderBrush="{ThemeResource RowSelectedBorderBrush}"
                                        BorderThickness="1"
                                        IsHitTestVisible="False"
                                        Visibility="{x:Bind IsSelected, Mode=OneWay}"/>
                                <Border Width="3"
                                        Height="24"
                                        CornerRadius="2"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Margin="7,0,0,0"
                                        Background="{ThemeResource BrandPrimaryBrush}"
                                        IsHitTestVisible="False"
                                        Visibility="{x:Bind IsSelected, Mode=OneWay}"/>

                                <!-- Exact Aligned Row Columns -->
                                <Grid Padding="18,6,18,6" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32"/>
                                        <ColumnDefinition Width="36"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <CheckBox MinWidth="0"
                                              Padding="0"
                                              VerticalAlignment="Center"
                                              IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                              IsEnabled="{x:Bind CanToggle, Mode=OneWay}"
                                              ToolTipService.ToolTip="{x:Bind Title}"
                                              AutomationProperties.Name="{x:Bind Title}"/>

                                    <controls:AvatarControl Grid.Column="1"
                                                            Width="34" Height="34"
                                                            VerticalAlignment="Center"
                                                            Title="{x:Bind Title}"
                                                            AvatarPath="{x:Bind AvatarLocalPath, Mode=OneWay}"
                                                            IsDimmed="{x:Bind IsDimmed, Mode=OneWay}"/>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{x:Bind Title}"
                                                   FontSize="13.5"
                                                   FontWeight="SemiBold"
                                                   MaxLines="2"
                                                   TextWrapping="Wrap"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTipService.ToolTip="{x:Bind Title}"/>
                                        <TextBlock Text="{x:Bind UsernameFormatted}"
                                                   Style="{StaticResource RowMetadataStyle}"
                                                   TextWrapping="NoWrap"
                                                   Visibility="{x:Bind ShowComparisonUsername, Mode=OneWay}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTipService.ToolTip="{x:Bind UsernameFormatted}"/>

                                        <!-- Compact Narrow-Window Metadata & Inline Pills -->
                                        <TextBlock Text="{x:Bind CompactSubtitle}"
                                                   Style="{StaticResource RowMetadataStyle}"
                                                   Visibility="{x:Bind ShowCompactDetails, Mode=OneWay}"
                                                   Typography.NumeralAlignment="Tabular"/>
                                        <StackPanel Orientation="Horizontal"
                                                    Spacing="6"
                                                    Margin="0,3,0,0"
                                                    Visibility="{x:Bind ShowCompactDetails, Mode=OneWay}">
                                            <controls:StatusBadge Text="{x:Bind CleanStatusText, Mode=OneWay}"
                                                                  Tone="{x:Bind StatusTone, Mode=OneWay}"
                                                                  ShowDot="{x:Bind ShowStatusDot, Mode=OneWay}"/>
                                            <controls:StatusBadge Text="{x:Bind UnreadBadgeText}"
                                                                  Tone="Accent"
                                                                  Visibility="{x:Bind HasUnread}"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Wide-Window Comparison Columns -->
                                    <Grid Grid.Column="3" ColumnSpacing="12" Visibility="{x:Bind ShowComparison, Mode=OneWay}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="88"/>
                                            <ColumnDefinition Width="104"/>
                                            <ColumnDefinition Width="96"/>
                                            <ColumnDefinition Width="108"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="{x:Bind ParticipantsText}" Style="{StaticResource NumericCellStyle}"/>

                                        <Grid Grid.Column="1" VerticalAlignment="Center">
                                            <controls:StatusBadge HorizontalAlignment="Right"
                                                                  Text="{x:Bind UnreadBadgeText}"
                                                                  Tone="Accent"
                                                                  Visibility="{x:Bind HasUnread}"/>
                                            <TextBlock Text="—"
                                                       Style="{StaticResource NumericCellStyle}"
                                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                       Visibility="{x:Bind UnreadCount, Converter={StaticResource ZeroIntToVis}}"/>
                                        </Grid>

                                        <TextBlock Grid.Column="2"
                                                   Text="{x:Bind ActivityDateText}"
                                                   Style="{StaticResource NumericCellStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                                        <controls:StatusBadge Grid.Column="3"
                                                              HorizontalAlignment="Right"
                                                              Text="{x:Bind CleanStatusText, Mode=OneWay}"
                                                              Tone="{x:Bind StatusTone, Mode=OneWay}"
                                                              ShowDot="{x:Bind ShowStatusDot, Mode=OneWay}"/>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Empty State -->
                <StackPanel Grid.Row="1"
                            Visibility="{x:Bind ViewModel.ShowEmpty, Mode=OneWay}"
                            MaxWidth="360"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Spacing="10"
                            Margin="20">
                    <Border Width="48" Height="48" CornerRadius="24" Background="{ThemeResource BrandSubtleBrush}" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE721;" FontSize="20" Foreground="{ThemeResource BrandTextBrush}"/>
                    </Border>
                    <TextBlock Text="{x:Bind ViewModel.EmptyTitle, Mode=OneWay}" Style="{StaticResource SectionTitleStyle}" TextAlignment="Center"/>
                    <TextBlock Text="{x:Bind ViewModel.EmptyHint, Mode=OneWay}" Style="{StaticResource SupportingTextStyle}" TextAlignment="Center"/>
                    <Button Content="Сбросить фильтры"
                            HorizontalAlignment="Center"
                            Command="{x:Bind ViewModel.ClearFiltersCommand}"
                            Visibility="{x:Bind ViewModel.HasFilters, Mode=OneWay}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Row 4: Action Footer Bar -->
        <Border Grid.Row="4" Style="{StaticResource CardPanelStyle}" Padding="14,9">
            <Grid ColumnSpacing="10" RowSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition x:Name="FooterActionsColumn" Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel x:Name="SelectionSummaryPanel" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind ViewModel.SelectionCounterText, Mode=OneWay}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Typography.NumeralAlignment="Tabular"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               AutomationProperties.LiveSetting="Polite"/>
                    <TextBlock x:Name="FooterStatusText"
                               Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                               Style="{StaticResource RowMetadataStyle}"
                               VerticalAlignment="Center"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis"
                               Visibility="{x:Bind ViewModel.HasStatusMessage, Mode=OneWay}"/>
                </StackPanel>

                <StackPanel x:Name="FooterActionsPanel"
                            Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="8"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Button x:Name="ClearSelection"
                            Content="Снять выбор"
                            Command="{x:Bind ViewModel.DeselectAllCommand}"
                            Visibility="{x:Bind ViewModel.CanExecuteAction, Mode=OneWay}"/>
                    <Button x:Name="ReviewSelection"
                            Style="{ThemeResource AccentButtonStyle}"
                            IsEnabled="{x:Bind ViewModel.CanExecuteAction, Mode=OneWay}"
                            Click="OnReviewSelection">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon Glyph="&#xE73E;" FontSize="13"/>
                            <TextBlock Text="{x:Bind ViewModel.ActionButtonText, Mode=OneWay}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
