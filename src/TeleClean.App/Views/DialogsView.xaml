<Page x:Class="TeleClean.App.Views.DialogsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:TeleClean.App.ViewModels" xmlns:controls="using:TeleClean.App.Controls">
    <Grid Background="{ThemeResource WorkspaceBrush}" Padding="18,12" RowSpacing="8" SizeChanged="OnWorkspaceSizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Spacing="2">
            <TextBlock Text="{x:Bind ViewModel.CurrentCategoryTitleWithCount, Mode=OneWay}"
                Style="{StaticResource WorkspaceTitle}" AutomationProperties.HeadingLevel="Level1"/>
            <TextBlock Text="{x:Bind ViewModel.CategoryHint, Mode=OneWay}" Style="{StaticResource SupportingText}"/>
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBox x:Name="SearchBox" PlaceholderText="Название или @имя" AutomationProperties.Name="Поиск в категории"
                ToolTipService.ToolTip="Поиск в категории (Ctrl+F)" IsSpellCheckEnabled="False"
                Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                <TextBox.KeyboardAccelerators>
                    <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="OnSearchShortcut"/>
                </TextBox.KeyboardAccelerators>
            </TextBox>
            <Grid x:Name="FilterBar" Grid.Column="1" ColumnSpacing="6">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <ComboBox MinWidth="116" AutomationProperties.Name="Фильтр" ToolTipService.ToolTip="Фильтр"
                    ItemsSource="{x:Bind ViewModel.FilterOptions}" SelectedIndex="{x:Bind ViewModel.SelectedFilterIndex, Mode=TwoWay}"/>
                <ComboBox Grid.Column="1" MinWidth="148" AutomationProperties.Name="Сортировка" ToolTipService.ToolTip="Сортировка"
                    ItemsSource="{x:Bind ViewModel.SortOptions}" SelectedIndex="{x:Bind ViewModel.SelectedSortIndex, Mode=TwoWay}"/>
                <Button Grid.Column="2" Command="{x:Bind ViewModel.LoadDialogsCommand}"
                    IsEnabled="{x:Bind ViewModel.CanRefresh, Mode=OneWay}" AutomationProperties.Name="Обновить список" ToolTipService.ToolTip="Обновить список (F5)">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                        <TextBlock Text="Обновить"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>

        <StackPanel Grid.Row="2" Spacing="6">
            <InfoBar Title="Список недоступен" Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                Severity="Error" IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}" IsClosable="False"/>
            <TextBlock Visibility="{x:Bind ViewModel.HasStatusMessage, Mode=OneWay}" Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" Style="{StaticResource SupportingText}" AutomationProperties.LiveSetting="Polite"/>
            <ProgressBar IsIndeterminate="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}"/>
        </StackPanel>

        <Border Grid.Row="3" Style="{StaticResource WorkspacePanel}">
            <Grid Padding="6,2">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid MinHeight="40" Padding="8,0" ColumnSpacing="8"
                      BorderThickness="0,0,0,1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32"/><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox x:Name="SelectVisible" MinWidth="0" Padding="0" IsThreeState="False"
                        AutomationProperties.Name="Выбрать видимые" ToolTipService.ToolTip="Выбрать видимые"
                        IsChecked="{x:Bind ViewModel.IsAllSelectedInView, Mode=OneWay}"
                        IsEnabled="{x:Bind ViewModel.CanSelectVisible, Mode=OneWay}" Click="OnSelectVisible"/>
                    <TextBlock x:Name="NameHeading" Grid.Column="2" VerticalAlignment="Center" FontWeight="SemiBold"
                        Text="Название"/>
                    <Grid x:Name="ComparisonHeading" Grid.Column="3" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="86"/><ColumnDefinition Width="106"/><ColumnDefinition Width="132"/><ColumnDefinition Width="112"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Участники" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="1" Text="Непрочитано" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="2" Text="Последняя активность" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12"/>
                        <TextBlock Grid.Column="3" Text="Статус" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    </Grid>
                </Grid>
                <ListView Grid.Row="1" SelectionMode="None" ItemsSource="{x:Bind ViewModel.VisibleDialogs, Mode=OneWay}"
                    AutomationProperties.Name="Диалоги текущей категории">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="AutomationProperties.Name" Value="{Binding Title}"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:DialogItemViewModel">
                            <Grid MinHeight="49" ColumnSpacing="8" Padding="8,0" CornerRadius="5" Tapped="OnRowTapped"
                                  Background="Transparent">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32"/><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.ColumnSpan="4" Margin="-8,0" CornerRadius="5"
                                    Background="{ThemeResource SelectionBrush}" IsHitTestVisible="False" Visibility="{x:Bind IsSelected, Mode=OneWay}"/>
                                <CheckBox MinWidth="0" Padding="0" IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                          IsEnabled="{x:Bind CanToggle, Mode=OneWay}" AutomationProperties.Name="{x:Bind Title}"/>
                                <controls:AvatarControl Grid.Column="1" Width="30" Height="30" VerticalAlignment="Center"
                                    Title="{x:Bind Title}" AvatarPath="{x:Bind AvatarLocalPath, Mode=OneWay}" IsDimmed="{x:Bind IsDimmed, Mode=OneWay}"/>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{x:Bind Description}" FontSize="12"
                                        Visibility="{x:Bind ShowCompactDetails, Mode=OneWay}"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{x:Bind UsernameFormatted}" FontSize="12"
                                        Visibility="{x:Bind ShowComparisonUsername, Mode=OneWay}"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <Grid Grid.Column="3" ColumnSpacing="8" Visibility="{x:Bind ShowComparison, Mode=OneWay}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="86"/><ColumnDefinition Width="106"/><ColumnDefinition Width="132"/><ColumnDefinition Width="112"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind ParticipantsText}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{x:Bind UnreadCount}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{x:Bind ActivityDateText}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="{x:Bind DisplayStatus, Mode=OneWay}" HorizontalAlignment="Right"
                                        VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </Grid>
                                <TextBlock Grid.Column="3" VerticalAlignment="Center" MaxWidth="92" TextAlignment="Right"
                                    Visibility="{x:Bind ShowCompactDetails, Mode=OneWay}" Text="{x:Bind StatusBadge, Mode=OneWay}"
                                    Style="{StaticResource SupportingText}" FontSize="12"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <StackPanel Grid.Row="1" Visibility="{x:Bind ViewModel.ShowEmpty, Mode=OneWay}" MaxWidth="330"
                    VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8" Margin="12">
                    <FontIcon Glyph="&#xE721;" FontSize="23" Foreground="{ThemeResource BrandBrush}"/>
                    <TextBlock Text="{x:Bind ViewModel.EmptyTitle, Mode=OneWay}" Style="{ThemeResource SubtitleTextBlockStyle}" TextAlignment="Center"/>
                    <TextBlock Text="{x:Bind ViewModel.EmptyHint, Mode=OneWay}" Style="{StaticResource SupportingText}" TextAlignment="Center"/>
                    <Button Content="Сбросить фильтры" HorizontalAlignment="Center" Command="{x:Bind ViewModel.ClearFiltersCommand}"
                        Visibility="{x:Bind ViewModel.HasFilters, Mode=OneWay}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="4" Style="{StaticResource WorkspacePanel}" Padding="10,6">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind ViewModel.SelectionCounterText, Mode=OneWay}" FontWeight="SemiBold"
                        VerticalAlignment="Center" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                    <Button Content="Снять выбор" Command="{x:Bind ViewModel.DeselectAllCommand}"
                        Visibility="{x:Bind ViewModel.CanExecuteAction, Mode=OneWay}"/>
                </StackPanel>
                <Button Grid.Column="1" Content="{x:Bind ViewModel.ActionButtonText, Mode=OneWay}"
                    Style="{ThemeResource AccentButtonStyle}" IsEnabled="{x:Bind ViewModel.CanExecuteAction, Mode=OneWay}"
                    Click="OnReviewSelection"/>
            </Grid>
        </Border>
    </Grid>
</Page>
