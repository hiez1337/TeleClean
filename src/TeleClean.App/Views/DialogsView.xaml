<Page
    x:Class="TeleClean.App.Views.DialogsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:TeleClean.App.Controls"
    xmlns:converters="using:TeleClean.App.Converters"
    xmlns:vm="using:TeleClean.App.ViewModels"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:InvertedBooleanToVisibilityConverter x:Key="InvertedBoolToVis" />
        <converters:RowSelectedBackgroundConverter x:Key="RowSelectedBgConverter" />
        <converters:ActiveToForegroundConverter x:Key="ActiveToFgConverter" />
        <converters:UnreadBadgeBackgroundConverter x:Key="UnreadBgConverter" />
        <converters:UnreadBadgeForegroundConverter x:Key="UnreadFgConverter" />
    </Page.Resources>

    <Grid Padding="24,14,24,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <!-- 0: Header & Action Bar -->
            <RowDefinition Height="Auto" />
            <!-- 1: Table / Virtualized ListView Container -->
            <RowDefinition Height="*" />
            <!-- 2: Bottom Status Bar -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top Header & Action Buttons -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Category Title with Count (e.g. Каналы (178)) -->
            <TextBlock
                Grid.Column="0"
                Text="{x:Bind ViewModel.CurrentCategoryTitleWithCount, Mode=OneWay}"
                FontWeight="SemiBold"
                FontSize="18"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorPrimaryBrush}" />

            <!-- Action Buttons: Select All & Exit Selected -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button
                    Content="Выбрать все"
                    Command="{x:Bind ViewModel.SelectAllCommand}"
                    Height="32"
                    CornerRadius="4"
                    Padding="12,0" />

                <Button
                    Content="{x:Bind ViewModel.ActionButtonText, Mode=OneWay}"
                    Command="{x:Bind ViewModel.StartBulkActionCommand}"
                    IsEnabled="{x:Bind ViewModel.CanExecuteAction, Mode=OneWay}"
                    Style="{ThemeResource AccentButtonStyle}"
                    Height="32"
                    CornerRadius="4"
                    Padding="16,0"
                    FontWeight="SemiBold" />
            </StackPanel>
        </Grid>

        <!-- Table Container -->
        <Border
            Grid.Row="1"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">

            <Grid>
                <Grid.RowDefinitions>
                    <!-- Table Header -->
                    <RowDefinition Height="Auto" />
                    <!-- Table Rows -->
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Clean Table Header Row -->
                <Border
                    Grid.Row="0"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="0,0,0,1"
                    Height="38"
                    Padding="12,0">

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="42" />                   <!-- [Checkbox] -->
                            <ColumnDefinition Width="*" MinWidth="220" />      <!-- [Название (@username)] -->
                            <ColumnDefinition Width="95" />                    <!-- [Категория] -->
                            <ColumnDefinition Width="105" />                   <!-- [Подписчики] -->
                            <ColumnDefinition Width="95" />                    <!-- [Непрочитано] -->
                            <ColumnDefinition Width="155" />                   <!-- [Последняя активность] -->
                            <ColumnDefinition Width="100" />                   <!-- [Статус] -->
                        </Grid.ColumnDefinitions>

                        <!-- Header Checkbox (Select / Deselect all in current view) -->
                        <CheckBox
                            Grid.Column="0"
                            IsChecked="{x:Bind ViewModel.IsAllSelectedInView, Mode=TwoWay}"
                            VerticalAlignment="Center" />

                        <Button
                            Grid.Column="1"
                            Content="[Название (@username)]"
                            Command="{x:Bind ViewModel.SortByTitleCommand}"
                            Style="{StaticResource TableHeaderButtonStyle}"
                            VerticalAlignment="Center" />

                        <TextBlock
                            Grid.Column="2"
                            Text="[Категория]"
                            Style="{StaticResource TableHeaderTextStyle}" />

                        <Button
                            Grid.Column="3"
                            Content="[Подписчики]"
                            Command="{x:Bind ViewModel.SortBySubscribersCommand}"
                            Style="{StaticResource TableHeaderButtonStyle}"
                            VerticalAlignment="Center" />

                        <Button
                            Grid.Column="4"
                            Content="[Непрочитано]"
                            Command="{x:Bind ViewModel.SortByUnreadCommand}"
                            Style="{StaticResource TableHeaderButtonStyle}"
                            VerticalAlignment="Center" />

                        <Button
                            Grid.Column="5"
                            Content="[Последняя активность]"
                            Command="{x:Bind ViewModel.SortByActivityCommand}"
                            Style="{StaticResource TableHeaderButtonStyle}"
                            VerticalAlignment="Center" />

                        <TextBlock
                            Grid.Column="6"
                            Text="[Статус]"
                            Style="{StaticResource TableHeaderTextStyle}" />
                    </Grid>
                </Border>

                <!-- Virtualized High-Performance Dialogs Table Rows -->
                <ListView
                    Grid.Row="1"
                    ItemsSource="{x:Bind ViewModel.VisibleDialogs, Mode=OneWay}"
                    SelectionMode="None"
                    Padding="0">

                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="MinHeight" Value="0" />
                        </Style>
                    </ListView.ItemContainerStyle>

                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsStackPanel AreStickyGroupHeadersEnabled="False" CacheLength="4.0" />
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>

                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:DialogItemViewModel">
                            <Border
                                Height="54"
                                BorderThickness="0,0,0,1"
                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                Background="{x:Bind IsSelected, Converter={StaticResource RowSelectedBgConverter}, Mode=OneWay}"
                                Tag="{x:Bind}"
                                Tapped="OnRowTapped">

                                <Grid>
                                    <!-- Left Accent Vertical Indicator for Selected Row (flush with left edge) -->
                                    <Rectangle
                                        HorizontalAlignment="Left"
                                        Width="3.5"
                                        Height="34"
                                        RadiusX="1.75" RadiusY="1.75"
                                        Fill="{ThemeResource AccentFillColorDefaultBrush}"
                                        Visibility="{x:Bind IsSelected, Converter={StaticResource BoolToVis}, Mode=OneWay}" />

                                    <Grid ColumnSpacing="12" Padding="12,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="42" />                   <!-- [Checkbox] -->
                                            <ColumnDefinition Width="*" MinWidth="220" />      <!-- [Название (@username)] -->
                                            <ColumnDefinition Width="95" />                    <!-- [Категория] -->
                                            <ColumnDefinition Width="105" />                   <!-- [Подписчики] -->
                                            <ColumnDefinition Width="95" />                    <!-- [Непрочитано] -->
                                            <ColumnDefinition Width="155" />                   <!-- [Последняя активность] -->
                                            <ColumnDefinition Width="100" />                   <!-- [Статус] -->
                                        </Grid.ColumnDefinitions>

                                        <!-- Row CheckBox (aligned with header checkbox) -->
                                        <CheckBox
                                            Grid.Column="0"
                                            IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                            IsEnabled="{x:Bind IsJoined, Mode=OneWay}"
                                            VerticalAlignment="Center" />

                                        <!-- Title, Avatar (32px) and Username -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                                            <controls:AvatarControl
                                                Title="{x:Bind Title}"
                                                AvatarPath="{x:Bind AvatarLocalPath, Mode=OneWay}"
                                                IsDimmed="{x:Bind IsDimmed, Mode=OneWay}"
                                                Width="32" Height="32"
                                                VerticalAlignment="Center" />

                                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                                <TextBlock
                                                    Text="{x:Bind Title}"
                                                    FontWeight="SemiBold"
                                                    FontSize="13"
                                                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                    TextTrimming="CharacterEllipsis" />

                                                <TextBlock
                                                    Text="{x:Bind UsernameFormatted}"
                                                    FontSize="11.5"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Category -->
                                        <TextBlock
                                            Grid.Column="2"
                                            Text="{x:Bind CategoryText}"
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            VerticalAlignment="Center"
                                            TextTrimming="CharacterEllipsis" />

                                        <!-- Subscribers -->
                                        <TextBlock
                                            Grid.Column="3"
                                            Text="{x:Bind SubscribersText}"
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                            VerticalAlignment="Center" />

                                        <!-- Unread Count (badge / pill when > 0) -->
                                        <Border
                                            Grid.Column="4"
                                            Background="{x:Bind UnreadCount, Converter={StaticResource UnreadBgConverter}, Mode=OneWay}"
                                            CornerRadius="10"
                                            Padding="8,2"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center">
                                            <TextBlock
                                                Text="{x:Bind UnreadCount}"
                                                FontSize="12"
                                                FontWeight="SemiBold"
                                                Foreground="{x:Bind UnreadCount, Converter={StaticResource UnreadFgConverter}, Mode=OneWay}"
                                                VerticalAlignment="Center" />
                                        </Border>

                                        <!-- Last Activity -->
                                        <TextBlock
                                            Grid.Column="5"
                                            Text="{x:Bind FormattedLastActivity}"
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            VerticalAlignment="Center" />

                                        <!-- Status -->
                                        <TextBlock
                                            Grid.Column="6"
                                            Text="{x:Bind StatusText}"
                                            FontSize="12"
                                            Foreground="{x:Bind IsActive, Converter={StaticResource ActiveToFgConverter}, Mode=OneWay}"
                                            VerticalAlignment="Center" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Empty State Message -->
                <StackPanel
                    Grid.Row="1"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Spacing="8"
                    Visibility="{x:Bind ViewModel.VisibleDialogs.Count, Converter={StaticResource InvertedBoolToVis}, Mode=OneWay}">
                    <FontIcon Glyph="&#xE774;" FontSize="32" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="В этой категории нет диалогов" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13" HorizontalAlignment="Center" />
                </StackPanel>

                <!-- Loading ProgressRing -->
                <ProgressRing
                    Grid.Row="1"
                    IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.IsBusy, Converter={StaticResource BoolToVis}, Mode=OneWay}"
                    Width="40" Height="40"
                    HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- Bottom Status Bar -->
        <Border
            Grid.Row="2"
            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="6"
            Height="30"
            Padding="12,0">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Column="0"
                    Text="{x:Bind ViewModel.BottomStatusBarText, Mode=OneWay}"
                    FontSize="11.5"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    VerticalAlignment="Center"
                    Margin="0,0,8,0"
                    TextTrimming="CharacterEllipsis" />

                <Button
                    Grid.Column="1"
                    Content="🔄 Обновить"
                    Command="{x:Bind ViewModel.LoadDialogsCommand}"
                    Style="{StaticResource SubtleIconButton}"
                    Height="24"
                    Padding="8,0"
                    VerticalAlignment="Center"
                    FontSize="11" />
            </Grid>
        </Border>
    </Grid>
</Page>
