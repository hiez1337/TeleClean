<UserControl
    x:Class="TeleClean.App.Controls.SettingsCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="False">
    <Border Style="{StaticResource CardPanelStyle}" Padding="18,14">
        <Grid x:Name="CardGrid" ColumnSpacing="16" RowSpacing="10" SizeChanged="OnCardSizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="ActionColumn" Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border x:Name="IconHost" Width="34" Height="34" CornerRadius="8"
                    Background="{ThemeResource CardSurfaceSubtleBrush}"
                    BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1"
                    VerticalAlignment="Center">
                <FontIcon x:Name="IconGlyph" FontSize="15" Foreground="{ThemeResource BrandTextBrush}"/>
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                <TextBlock x:Name="HeaderText" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock x:Name="DescriptionText" Style="{StaticResource RowMetadataStyle}"/>
            </StackPanel>

            <ContentPresenter x:Name="ActionHost" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"/>
        </Grid>
    </Border>
</UserControl>
