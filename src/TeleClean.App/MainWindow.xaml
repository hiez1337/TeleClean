<Window x:Class="TeleClean.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:TeleClean.App.Views" Title="TeleClean">
    <Window.SystemBackdrop><MicaBackdrop Kind="Base"/></Window.SystemBackdrop>
    <Grid x:Name="RootGrid">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="F5" Invoked="OnRefreshShortcut"/>
        </Grid.KeyboardAccelerators>
        <NavigationView x:Name="Navigation" Visibility="Collapsed"
            PaneDisplayMode="Auto" ExpandedModeThresholdWidth="900" CompactModeThresholdWidth="660"
            OpenPaneLength="176" IsBackButtonVisible="Collapsed" IsSettingsVisible="False"
            DisplayModeChanged="OnNavigationDisplayModeChanged" SelectionChanged="OnNavigationChanged">
            <NavigationView.PaneHeader>
                <StackPanel Orientation="Horizontal" Spacing="10" Margin="12,0,0,0">
                    <Border Background="{ThemeResource BrandBrush}" Width="32" Height="32" CornerRadius="9">
                        <FontIcon Glyph="&#xE724;" FontSize="15" Foreground="{ThemeResource OnBrandBrush}"/>
                    </Border>
                    <TextBlock Text="TeleClean" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
            </NavigationView.PaneHeader>
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="Channels" Tag="0" Content="{x:Bind DialogListVm.ChannelsHeaderText, Mode=OneWay}">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE789;"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="1" Content="{x:Bind DialogListVm.ChatsHeaderText, Mode=OneWay}" Icon="People"/>
                <NavigationViewItem Tag="2" Content="{x:Bind DialogListVm.BotsHeaderText, Mode=OneWay}">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE950;"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="3" Content="{x:Bind DialogListVm.DeletedHeaderText, Mode=OneWay}" Icon="Delete"/>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Name="Operations" Tag="4" Content="{x:Bind BulkExecutionVm.OperationsHeaderText, Mode=OneWay}" Icon="List"/>
                <NavigationViewItem Tag="5" Content="Настройки" Icon="Setting"/>
            </NavigationView.FooterMenuItems>
            <Frame x:Name="ContentFrame" IsNavigationStackEnabled="False"/>
        </NavigationView>
        <views:AuthView x:Name="AuthViewControl"/>
    </Grid>
</Window>
