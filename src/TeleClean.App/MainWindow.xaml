<Window
    x:Class="TeleClean.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:TeleClean.App.Views"
    mc:Ignorable="d"
    Title="TeleClean">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="Base" />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" Background="Transparent">
        <Grid.RowDefinitions>
            <!-- Single-Level Top Bar (TitleBar + Navigation) -->
            <RowDefinition Height="Auto" />
            <!-- Main Content Row -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom Fluent Single-Level Top Bar -->
        <Grid x:Name="TopNavHeader" Grid.Row="0" Height="48" Background="Transparent">
            <Grid.ColumnDefinitions>
                <!-- Left: App Branding -->
                <ColumnDefinition Width="Auto" />
                <!-- Center: 5 Header Tabs -->
                <ColumnDefinition Width="*" />
                <!-- Right: Settings Icon Button + Caption Buttons Reservation -->
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Left: App Branding (Drag Region) -->
            <StackPanel x:Name="AppDragArea" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,16,0" Spacing="8" Background="Transparent">
                <!-- Telegram Blue Circle Icon -->
                <Border Width="24" Height="24" CornerRadius="12" Background="#2990FF" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE724;" FontSize="11" Foreground="White" Margin="-1,1,0,0" />
                </Border>
                <TextBlock Text="TeleClean" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                <Border Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="3" Padding="4,1" VerticalAlignment="Center">
                    <TextBlock Text="v2.0" FontSize="9.5" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Border>
            </StackPanel>

            <!-- Center: 5 Header Tabs with dynamic badge counts -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Stretch" Spacing="4">
                <!-- 0: Channels Tab -->
                <Button x:Name="TabChannels" Click="OnHeaderTabClicked" Tag="0" Style="{StaticResource HeaderTabButtonStyle}">
                    <Grid VerticalAlignment="Center" Height="44">
                        <TextBlock x:Name="TabChannelsText" Text="{x:Bind DialogListVm.ChannelsHeaderText, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                        <Rectangle x:Name="TabChannelsLine" Height="2.5" Fill="{ThemeResource AccentFillColorDefaultBrush}" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Visibility="Visible" RadiusX="1.25" RadiusY="1.25" />
                    </Grid>
                </Button>

                <!-- 1: Chats Tab -->
                <Button x:Name="TabChats" Click="OnHeaderTabClicked" Tag="1" Style="{StaticResource HeaderTabButtonStyle}">
                    <Grid VerticalAlignment="Center" Height="44">
                        <TextBlock x:Name="TabChatsText" Text="{x:Bind DialogListVm.ChatsHeaderText, Mode=OneWay}" FontSize="13" FontWeight="Normal" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                        <Rectangle x:Name="TabChatsLine" Height="2.5" Fill="{ThemeResource AccentFillColorDefaultBrush}" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Visibility="Collapsed" RadiusX="1.25" RadiusY="1.25" />
                    </Grid>
                </Button>

                <!-- 2: Bots Tab -->
                <Button x:Name="TabBots" Click="OnHeaderTabClicked" Tag="2" Style="{StaticResource HeaderTabButtonStyle}">
                    <Grid VerticalAlignment="Center" Height="44">
                        <TextBlock x:Name="TabBotsText" Text="{x:Bind DialogListVm.BotsHeaderText, Mode=OneWay}" FontSize="13" FontWeight="Normal" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                        <Rectangle x:Name="TabBotsLine" Height="2.5" Fill="{ThemeResource AccentFillColorDefaultBrush}" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Visibility="Collapsed" RadiusX="1.25" RadiusY="1.25" />
                    </Grid>
                </Button>

                <!-- 3: Deleted Tab -->
                <Button x:Name="TabDeleted" Click="OnHeaderTabClicked" Tag="3" Style="{StaticResource HeaderTabButtonStyle}">
                    <Grid VerticalAlignment="Center" Height="44">
                        <TextBlock x:Name="TabDeletedText" Text="{x:Bind DialogListVm.DeletedHeaderText, Mode=OneWay}" FontSize="13" FontWeight="Normal" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                        <Rectangle x:Name="TabDeletedLine" Height="2.5" Fill="{ThemeResource AccentFillColorDefaultBrush}" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Visibility="Collapsed" RadiusX="1.25" RadiusY="1.25" />
                    </Grid>
                </Button>

                <!-- 4: Operations Tab -->
                <Button x:Name="TabOperations" Click="OnHeaderTabClicked" Tag="4" Style="{StaticResource HeaderTabButtonStyle}">
                    <Grid VerticalAlignment="Center" Height="44">
                        <TextBlock x:Name="TabOperationsText" Text="{x:Bind BulkExecutionVm.OperationsHeaderText, Mode=OneWay}" FontSize="13" FontWeight="Normal" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                        <Rectangle x:Name="TabOperationsLine" Height="2.5" Fill="{ThemeResource AccentFillColorDefaultBrush}" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Visibility="Collapsed" RadiusX="1.25" RadiusY="1.25" />
                    </Grid>
                </Button>
            </StackPanel>

            <!-- Right: Search Box + Settings Button + Window Caption Buttons Reservation -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,140,0" Spacing="8">
                <!-- Search Box with Ctrl+F Hint -->
                <Grid Width="180" Height="30">
                    <TextBox
                        x:Name="HeaderSearchBox"
                        PlaceholderText="Поиск..."
                        Text="{x:Bind DialogListVm.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        GotFocus="OnSearchBoxGotFocus"
                        FontSize="12"
                        Padding="8,3,52,3"
                        CornerRadius="4"
                        VerticalAlignment="Center">
                        <TextBox.KeyboardAccelerators>
                            <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="OnSearchAcceleratorInvoked" />
                        </TextBox.KeyboardAccelerators>
                    </TextBox>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0" Spacing="3" IsHitTestVisible="False">
                        <Border Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="3" Padding="2.5,0">
                            <TextBlock Text="Ctrl+F" FontSize="9" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        </Border>
                        <FontIcon Glyph="&#xE721;" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>

                <Button
                    x:Name="NavSettingsBtn"
                    Click="OnSettingsButtonClicked"
                    Width="32" Height="32"
                    Padding="0"
                    CornerRadius="4"
                    ToolTipService.ToolTip="Настройки"
                    Style="{StaticResource SubtleIconButton}">
                    <FontIcon Glyph="&#xE713;" FontSize="15" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Main Content Frame Host -->
        <Frame x:Name="ContentFrame" Grid.Row="1" />

        <!-- Full-Window Authentication Overlay Host -->
        <Border
            x:Name="AuthHostOverlay"
            Grid.Row="0" Grid.RowSpan="2"
            Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
            Visibility="Visible">
            <views:AuthView x:Name="AuthViewControl" />
        </Border>
    </Grid>
</Window>
